[submodule "tools/act"]
	path = tools/act
	url = git@github.com:nektos/act.git
[submodule "tools/calcurse"]
	path = tools/calcurse
	url = git@github.com:lfos/calcurse.git
[submodule "tools/lazyactions"]
	path = tools/lazyactions
