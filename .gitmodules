[submodule "tools/.pyenv"]
	path = tools/.pyenv
	url = https://github.com/pyenv/pyenv.git
[submodule "tools/.phpenv"]
	path = tools/.phpenv
	url = https://github.com/phpenv/phpenv.git
[submodule "tools/.rbenv"]
	path = tools/.rbenv
	url = https://github.com/rbenv/rbenv.git
[submodule "tools/nvm"]
	path = tools/nvm
	url = https://github.com/nvm-sh/nvm.git
[submodule "tools/.fzf"]
	path = tools/.fzf
	url = https://github.com/junegunn/fzf.git
[submodule "zsh/custom/plugins/zsh-autopair"]
