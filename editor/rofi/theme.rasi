/*
 * Darkvoid theme for rofi
 * Palette taken from the "darkvoid" pi theme.
 * Put in ~/.config/rofi/darkvoid.rasi and run: rofi -show drun -theme darkvoid
 */

* {
    font:             "FiraCode Nerd Font 10";

    /* darkvoid palette */
    bg:               #1c1c1c;
    fg:               #c0c0c0;
    focus:            #83b7ad;
    line-nr:          #404040;
    visual:           #303030;
    comment:          #858585;
    border-col:       #585858;
    func:             #e1e1e1;
    constant:         #b2d8d8;
    added:            #baffc9;
    error:            #ff7b72;
    warning:          #f2c879;
    surface-alt:      #202020;

    background-color: transparent;
    text-color:       @fg;
}

/*****----- Main Window -----*****/
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            500px;
    x-offset:         0px;
    y-offset:         0px;

    enabled:          true;
    margin:           0px;
    padding:          0px;
    border:           1px solid;
    border-radius:    12px;
    border-color:     @border-col;
    background-color: @bg;
    cursor:           "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:          true;
    spacing:          0px;
    margin:           0px;
    padding:          0px;
    border:           0px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:          true;
    spacing:          0px;
    margin:           0px;
    padding:          0px;
    border:           0px 0px 1px 0px;
    border-color:     @line-nr;
    border-radius:    12px 12px 0px 0px;
    background-color: @visual;
    text-color:       @fg;
    children:         [ "prompt", "entry" ];
}

prompt {
    enabled:          true;
    padding:          15px;
    border-radius:    12px 0px 0px 0px;
    background-color: @focus;
    text-color:       @bg;
    font:             "FiraCode Nerd Font Bold 12";
}

entry {
    enabled:          true;
    background-color: inherit;
    text-color:       @func;
    spacing:          10px;
    margin:           0px;
    padding:          15px;
    cursor:           text;
    placeholder:      "Search...";
    placeholder-color: @comment;
}

/*****----- Listview -----*****/
listview {
    enabled:          true;
    columns:          1;
    lines:            15;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;

    spacing:          2px;
    padding:          4px 0px;
    border:           0px;
    background-color: transparent;
    text-color:       @fg;
    cursor:           "default";
}

scrollbar {
    handle-width:     5px;
    handle-color:     @line-nr;
    border-radius:    0px;
    background-color: @bg;
}

/*****----- Elements -----*****/
element {
    enabled:          true;
    spacing:          8px;
    margin:           0px 6px;
    padding:          2px 4px;
    border:           0px;
    border-radius:    6px;
    background-color: transparent;
    text-color:       @fg;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @visual;
    text-color:       @focus;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @added;
}

element selected.active {
    background-color: @visual;
    text-color:       @added;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @error;
}

element selected.urgent {
    background-color: @visual;
    text-color:       @error;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             1.2em;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold underline #83b7ad;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/*****----- Message -----*****/
error-message {
    padding:          15px;
    border:           1px solid;
    border-radius:    12px;
    border-color:     @error;
    background-color: @bg;
    text-color:       @fg;
}

textbox {
    background-color: @bg;
    text-color:       @fg;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    highlight:        none;
}
