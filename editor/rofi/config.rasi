configuration {
    modi:                 "drun";
    show-icons:           true;
    icon-theme:           "Papirus-Dark";
    font:                 "JetBrainsMono Nerd Font 12";
    display-drun:         "";
    drun-display-format:  "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
    disable-history:      false;
    sort:                 true;
    matching:             "fuzzy";
}

@theme "darkvoid"

