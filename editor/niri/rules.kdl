window-rule {
    tiled-state true
    clip-to-geometry true
    geometry-corner-radius 12
    draw-border-with-background false
}

window-rule {
    match is-floating=false
    tiled-state true
    geometry-corner-radius 0
}


window-rule {
    match is-floating=true
    tiled-state true
    geometry-corner-radius 13
    clip-to-geometry true

    border {
        on
        width 1
        active-color "#343438"
        inactive-color "#28282C"
        urgent-color "#ffb86b"
    }

    shadow {
        on
        softness 10
        spread 6
        offset x=1 y=1
        color "rgba(14,14,14,0.6)"
    }
}


window-rule {
    match app-id="^popup-"
    open-floating true
    default-column-width {
        fixed 1600
    }
    default-window-height {
        fixed 900
    }
}
window-rule {
    match app-id="^org\\.pulseaudio\\.pavucontrol$"
    match app-id="^pavucontrol$"
    open-floating true
    default-column-width {
        fixed 900
    }
    default-window-height {
        fixed 600
    }
    // optional: open under the bar at the top right instead of centered
    default-floating-position x=16 y=48 relative-to="top-right"
}
window-rule {
    match app-id="^popup-nmtui$"
    default-column-width {
        fixed 700
    }
    default-window-height {
        fixed 450
    }
}
layer-rule {
    match namespace="^niri-backdrop$"
    place-within-backdrop true
}
layer-rule {
    match namespace="^linux-wallpaperengine$"
    place-within-backdrop true
}
layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}


