environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
 // XDG_DATA_DIRS "/usr/local/share:/usr/share"
    // MOZ_ENABLE_WAYLAND "1"
    // ELECTRON_OZONE_PLATFORM_HINT "auto"      // Electron apps (Discord, VS Code, etc.) run native Wayland, no blurry scaling
    // GDK_BACKEND "wayland,x11,*"
    // QT_QPA_PLATFORM "wayland;xcb"            // Qt apps prefer Wayland, fall back to X11
    // QT_QPA_PLATFORMTHEME "gtk3"
    // QT_QPA_PLATFORMTHEME "qt6ct"
    // QT_WAYLAND_DISABLE_WINDOWDECORATION "1"  // avoids Qt drawing its own title bars
}
input {
    keyboard {
        repeat-delay 300
        repeat-rate 45
        xkb {
            layout "us,ua"
            options "grp:win_space_toggle"
        }
        numlock
    }
    touchpad {
        tap
    }
    tablet {

    }
    mouse {
        accel-speed -0.25
        scroll-factor vertical=1.0 horizontal=-2.0
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth
}
output "HDMI-A-2" {
    mode "3840x2160@60.00"
    position x=0 y=0
    scale 1.1
    focus-at-startup
}
output "HDMI-A-1" {
    mode "1920x1080@60.00"
    position x=-1920 y=442
    scale 1
}
// iPad via Sunshine: fake-EDID connector on the AMD iGPU, toggled by sunshine global_prep_cmd
output "DP-1" {
    off
    mode custom=true "2388x1668@60"
    scale 2
    position x=3490 y=0
}
recent-windows {
    debounce-ms 750
    open-delay-ms 150
}
hotkey-overlay {
    skip-at-startup
}
screenshot-path "~/Media/Screenshots/%Y-%m-%d %H-%M-%S.png"
prefer-no-csd

