spawn-at-startup "xwayland-satellite" ":0"
spawn-at-startup "~/.config/waybar/launch.sh"
spawn-at-startup "swaybg" "-c" "#1c1c1c"
spawn-at-startup "wpe" "--screen-root" "HDMI-A-2" "--silent" "--fps" "24" "--scaling" "fill" "3411797914"
spawn-at-startup "mako"
spawn-at-startup "chromium"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
spawn-at-startup "kitty" "-e" "tmux" "new-session" "-A" "-s" "main"

