{
  // Hyprland bar
  "include": [
    "~/.config/waybar/common.jsonc",
    "~/.config/waybar/modules/hyprwhspr.jsonc",
    "~/.config/waybar/modules/notifications.jsonc",
    "~/.config/waybar/modules/bluetooth.jsonc",
    "~/.config/waybar/modules/splitkb.jsonc",
    "~/.config/waybar/modules/system.jsonc",
    "~/.config/waybar/modules/gpu.jsonc"
  ],

  "modules-center": ["clock"],
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-right": [
    "tray",
    "custom/notifications",
    "custom/hyprwhspr",
    "custom/bluetooth",
    "custom/splitkb",
    "custom/system",
    "custom/gpu",
    "pulseaudio",
    "network",
    "hyprland/language",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 36,
    "separate-outputs": true
  },

  "hyprland/language": {
    "class": "accent-focus",
    "format": "{short}"
  }
}
