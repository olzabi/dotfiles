{
  "custom/notifications": {
    "class": "accent-focus",
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/notifications.sh toggle",
    "on-click-middle": "~/.config/waybar/scripts/notifications.sh restore",
    "on-click-right": "~/.config/waybar/scripts/notifications.sh dismiss"
  }
}
