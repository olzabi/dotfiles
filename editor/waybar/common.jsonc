{
  // Bar geometry + native modules shared by every compositor.
  // Custom modules live in ./modules/*.jsonc (one file each).
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 4,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 5
  },

  "pulseaudio": {
    "class": "accent-const",
    "format": "{icon} {volume}%",
    "format-muted": "\udb81\udf5f muted",
    "format-icons": {
      "headphone": "\uf025",
      "default": ["\uf026", "\uf027", "\uf028"]
    },
    "scroll-step": 5,
    "on-click": "pkill -x pavucontrol || pavucontrol"
  },

  "network#wifi": {
    "class": "accent-info",
    "interface": "wl*",
    "format-wifi": "\uf1eb {signalStrength}%",
    "format-disconnected": "\udb81\uddaa",
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
    "on-click-right": "kitty --class popup-nmtui -e nmtui",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}"
  },

  // Wired: only visible while a cable is connected.
  "network#eth": {
    "class": "accent-info",
    "interface": "en*",
    "format-ethernet": "\udb80\ude00",
    "format-disconnected": "",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
  },

  "network#vpn": {
  "exec": "~/.config/waybar/scripts/vpn-status.sh",
  "return-type": "json",
  "on-click": "~/.config/waybar/scripts/vpn-popup.sh",
  "on-click-right": "pkill -x nm-connection-editor || nm-connection-editor"
  },

  "group/net": {
    "orientation": "inherit",
    "modules": ["network#wifi", "network#eth", "network#vpn"]
  },

  "battery": {
    "class": "accent-ok",
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  }
}
