#!/usr/bin/env bash
# herdr-side module: active plans (docs/plans/active/) of each agent repo, read from every worktree, with the bold
# part of their "Status:" line, open checkboxes (☐N) and open blockers (⛔N) listed under the plan.
#   plan mark: state of the agents working on it (▲ blocked ● working ◆ done ○ idle, ·N = agents; grey · = none);
#              an agent works on a plan when its branch contains the plan's slug (feat/catalog-engine-forms ->
#              catalog-engine; a plural slug also matches singular), or the plan is the one most mentioned in the
#              last 1 MB of its session transcript
#   #N after the slug: open PRs whose branch contains the slug (✓ ✗ ● = checks; from the prs section's index)
#   blockers (numbered items under "## Blockers"; "Resolved…" / "Resolved:" / ~~struck~~ closes one):
#     ? needs your decision (options/recommendation, "decision")   ⚑ needs you outside the code (browser, manual check)
#     ↳ waits on another blocker ("Depends on blocker N", shown under it)   ⧗ waits on other work ("waits for …")
#     • other   (items may be numbered or bulleted)
# A plan in several worktrees is read from the one an agent works on it in, else the main checkout, else the newest
# copy (a plan that so far exists only on a branch); a plan already
# moved out of active/ in the main checkout is skipped unless an agent works on it.
# Decision and manual blockers are also written to $XDG_RUNTIME_DIR/herdr-side/blockers.tsv for the attention section.
# Click / o: read the plan in Obsidian (bin/obs), revealed in the file explorer.
# ttl=30
set -u
. "$(dirname "$(readlink -f "$0")")/lib.sh"
run=${XDG_RUNTIME_DIR:-/tmp}/herdr-side

# repo<TAB>transcript-plan<TAB>state<TAB>checkout<TAB>branch<TAB>pane for every agent (repo = its main checkout, so an
# agent elsewhere that merely talks about a plan path is not linked to it; transcript-plan may be empty)
plan_agents() {
  local cfg=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  snapshot | jq -r '.agents[] | [.agent_status, .cwd // "", .agent_session.kind // "", .agent_session.value // "",
      .tokens.branch // "", .pane_id] | join("\u001f")' |
    while IFS=$'\x1f' read -r state cwd kind val branch pane; do
      repo=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
      repo=${repo%/.git}
      top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)
      f=; plan=
      case $kind in
        id) f=$(ls "$cfg"/projects/*/"$val".jsonl 2>/dev/null | head -1) ;;
        path) f=$val ;;
      esac
      [ -f "$f" ] && plan=$(tail -c 1000000 "$f" | grep -oE 'docs/plans/active/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+' |
        sort | uniq -c | sort -rn | awk 'NR == 1 { sub(".*/", "", $2); print $2 }')
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$repo" "$plan" "$state" "$top" "$branch" "$pane"
    done
}

# plan-dir<TAB>checkout<TAB>file (relative)<TAB>mtime for each active plan in each worktree of repo $1
plan_copies() {
  git -C "$1" worktree list --porcelain 2>/dev/null | awk '/^worktree / { print substr($0, 10) }' |
    while read -r wt; do
      for p in "$wt"/docs/plans/active/*; do
        f=$p; [ -d "$p" ] && f=$p/README.md
        [ -f "$f" ] && printf '%s\t%s\t%s\t%s\n' "${p##*/}" "$wt" "${f#"$wt"/}" "$(stat -c %Y "$f")"
      done
    done
}

# number<TAB>kind<TAB>depends-on<TAB>title for each open blocker in file $1
blockers() {
  awk '
    function flush(   b, d) {
      if (n == "") return
      b = tolower(body)
      if (b ~ /resolved:/ || tolower(title) ~ /^resolved/ || body ~ /~~/) { n = ""; return }
      kind = "open"; dep = ""
      if (match(b, /depends on blocker [0-9]+/)) { d = substr(b, RSTART, RLENGTH); sub(/.* /, "", d); dep = d; kind = "dependency" }
      else if (tolower(title) ~ /waits? for|waiting (for|on)|blocked by/) kind = "waiting" # the title says it best
      else if (b ~ /decision|options:|recommendation:/) kind = "decision"
      else if (b ~ /left for the user|needs a running|browser|manual|by hand/) kind = "external"
      else if (b ~ /waits? for|waiting (for|on)|blocked by|until .* (lands|merges|is merged)/) kind = "waiting"
      sub(/[.:]+$/, "", title)
      printf "%s\t%s\t%s\t%s\n", n, kind, dep, title
      n = ""
    }
    /^## / { flush(); inb = ($0 ~ /^## Blockers/); k = 0; next }
    !inb { next }
    /^([0-9]+\.|[-*]) / { # numbered or bulleted item; bullets are numbered by position
      flush(); k++; n = $0; if (n ~ /^[0-9]/) sub(/\..*/, "", n); else n = k; body = $0
      title = $0; sub(/^([0-9]+\.|[-*]) +/, "", title)
      if (match(title, /\*\*[^*]+\*\*/)) title = substr(title, RSTART + 2, RLENGTH - 4)
      next
    }
    n != "" && /^[ \t]/ { body = body " " $0 }
    END { flush() }
  ' "$1"
}

case ${1:-} in
  rows)
    links=$(plan_agents)
    touch "$run/prs.tsv"
    : > "$run/blockers.tsv.tmp"
    repos | while read -r root; do
      copies=$(plan_copies "$root")
      [ -n "$copies" ] || continue
      repo_row "$root"
      cut -f1 <<<"$copies" | sort -u | while read -r plan; do
        slug=${plan%.md}; slug=${slug#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}
        # agents on it: transcript names it, or their branch contains the slug (or its singular)
        mine=$(awk -F'\x1f' -v OFS='\t' -v r="$root" -v p="$plan" -v s="$slug" '
          $1 == r && ($2 == p || index($5, s) || (s ~ /s$/ && index($5, substr(s, 1, length(s) - 1)))) { print $1, $2, $3, $4 }' <<<"$links")
        prs=$(awk -F'\t' -v r="$root" -v s="$slug" '$1 == r && (index($3, s) || (s ~ /s$/ && index($3, substr(s, 1, length(s) - 1)))) {
          printf " #%s%s", $2, ($4 == "pass" ? "✓" : $4 == "fail" ? "✗" : $4 == "run" ? "●" : "") }' "$run/prs.tsv")
        # closed in the main checkout and nobody on it: a stale copy on an old branch
        [ -z "$mine" ] && ls -d "$root"/docs/plans/done/*/"$plan"* "$root"/docs/plans/superseded/"$plan"* >/dev/null 2>&1 && continue
        # copy to read: where an agent works on it, else the main checkout, else the newest
        pick=$(awk -F'\t' -v p="$plan" '$1 == p' <<<"$copies" | while IFS=$'\t' read -r _ wt rel mt; do
          pref=0; [ "$wt" = "$root" ] && pref=1; cut -f4 <<<"$mine" | grep -qxF "$wt" && pref=2
          printf '%s\t%s\t%s\t%s\n' "$pref" "$mt" "$wt" "$rel"
        done | sort -t$'\t' -k1,1nr -k2,2nr | head -1)
        IFS=$'\t' read -r _ _ wt rel <<<"$pick"
        f=$wt/$rel
        status=$(grep -m1 -E '^\**Status:?\**' "$f" | grep -oE '\*\*[^*]+\*\*' | head -1 | tr -d '*' | sed 's/\. .*//; s/\.$//')
        open=$(grep -cE '^\s*- \[ \]' "$f")
        bl=$(blockers "$f")
        nb=$(grep -c . <<<"$bl")
        states=$(cut -f3 <<<"$mine")
        n=$(grep -c . <<<"$states")
        case $states in # most urgent state of the plan's agents
          *blocked*) mark="$ERR▲" ;; *working*) mark="$WARN●" ;; *done*) mark="$INFO◆" ;;
          ?*) mark="$OK○" ;; *) mark="$MUTED·" ;;
        esac
        br=$(git -C "$wt" branch --show-current 2>/dev/null)
        where=; [ "$wt" = "$root" ] || where=" $MUTED⑂${br:-${wt##*/}}$R"
        printf 'plan\t%s|%s\t  %s%s%s %s%s%s%s%s\n' "$wt" "$rel" "$mark" "$R" \
          "$([ "$n" -gt 1 ] && printf '%s·%s%s' "$MUTED" "$n" "$R")" "$slug" "$where${prs:+$INFO$prs$R}" \
          "$([ "$nb" -gt 0 ] && printf ' %s⛔%s%s' "$ERR" "$nb" "$R")" \
          "$([ "$open" -gt 0 ] && printf ' %s☐%s%s' "$WARN" "$open" "$R")" "${status:+$MUTED · $status$R}"
        # blockers: dependencies right under the blocker they wait on
        [ "$nb" -gt 0 ] || continue
        printf '%s\n' "$bl" | awk -F'\t' '
          { num[NR] = $1; kind[NR] = $2; dep[NR] = $3; line[NR] = $0; has[$1] = 1 }
          END {
            for (i = 1; i <= NR; i++) if (kind[i] != "dependency" || !has[dep[i]]) {
              print "0\037" line[i]
              for (j = 1; j <= NR; j++) if (kind[j] == "dependency" && dep[j] == num[i]) print "1\037" line[j]
            }
          }' | tr '\t' '\037' | while IFS=$'\x1f' read -r nested num kind dep title; do # \x1f: empty fields survive
          case $kind in
            decision) icon="$WARN?" ;; external) icon="$INFO⚑" ;; dependency) icon="$MUTED↳" ;; waiting) icon="$MUTED⧗" ;;
            *) icon="$MUTED•" ;;
          esac
          pad="      "; [ "$nested" = 1 ] && pad="        "
          printf 'blocker\t%s|%s|%s\t%s%s%s %s%s%s %s\n' "$wt" "$rel" "$num" "$pad" "$icon" "$R" "$MUTED" "$num" "$R" "$title"
          case $kind in decision | external)
            printf '%s\t%s\t%s|%s\t%s\t%s\n' "$kind" "$slug" "$wt" "$rel" "$num" "$title" >> "$run/blockers.tsv.tmp" ;;
          esac
        done
      done
    done
    mv "$run/blockers.tsv.tmp" "$run/blockers.tsv" ;;
  act) # act KIND ID [ACTION]
    case ${2:-}:${4:-click} in
      plan:click | plan:open) side_open "${3%%|*}" "${3#*|}" ;;
      blocker:click | blocker:open) id=${3%|*}; side_open "${id%%|*}" "${id#*|}" ;;
      repo:open) side_open "$3" docs/plans/README.md ;;
      plan:changes | blocker:changes) side_changes "${3%%|*}" ;;
    esac ;;
esac
