#!/usr/bin/env bash
# herdr-side module: latest GitHub Actions run per workflow and branch for each agent repo (gh), only runs from
# the last $HERDR_SIDE_CI_DAYS days (default 7); older history is stale for an agent session.
#   ✓ success  ✗ failed/cancelled  ● queued/running   Click / o: open the run in the browser.
# ttl=60
set -u
. "$(dirname "$(readlink -f "$0")")/lib.sh"

case ${1:-} in
  rows)
    repos | while read -r root; do
      json=$(cd "$root" && gh run list --limit 30 \
        --json workflowName,headBranch,status,conclusion,createdAt,url 2>/dev/null) || continue
      [ "$json" = "[]" ] && continue
      repo_row "$root"
      out=$(jq -r --argjson days "${HERDR_SIDE_CI_DAYS:-7}" --arg R "$R" --arg DIM "$MUTED" --arg GRN "$OK" \
        --arg RED "$ERR" --arg YEL "$WARN" '
        def ago: (now - (.createdAt | fromdate)) as $s
          | if $s < 3600 then "\($s / 60 | floor)m" elif $s < 86400 then "\($s / 3600 | floor)h" else "\($s / 86400 | floor)d" end;
        map(select((.createdAt | fromdate) > now - $days * 86400))
        | group_by(.workflowName + "\u0000" + .headBranch) | map(max_by(.createdAt)) | sort_by(.createdAt) | reverse | .[:8][]
        | (if .status != "completed" then $YEL + "●" elif .conclusion == "success" then $GRN + "✓"
           elif .conclusion == "skipped" or .conclusion == "neutral" then $DIM + "○" else $RED + "✗" end) as $icon
        | "run\t\(.url)\t  \($icon)\($R) \(.workflowName | sub("^\\.github/workflows/"; "")) \($DIM)· \(.headBranch) · \(ago)\($R)"
      ' <<<"$json")
      if [ -n "$out" ]; then printf '%s\n' "$out"; else info_row "no runs in ${HERDR_SIDE_CI_DAYS:-7}d"; fi
    done ;;
  act) # act KIND ID [ACTION]
    case ${2:-}:${4:-click} in
      run:click | run:open) xdg-open "$3" ;;
      repo:click | repo:open) (cd "$3" && gh run list --web 2>/dev/null || gh browse --repo "$(gh repo view --json nameWithOwner -q .nameWithOwner)" actions) ;;
    esac ;;
esac
