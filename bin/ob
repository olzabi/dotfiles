#!/usr/bin/env bash
# Usage: ob [--here] [dir] [file] | ob <file>   — read dir (default: git root of $PWD, else $PWD) in Obsidian with the shared dotfiles
#                             config; file (relative to dir, e.g. docs/plans/active/x/README.md) is opened in it.
# Obsidian scans and watches every file in a vault ("Excluded files" only hides them), so instead of opening the
# project itself we open a mirror vault under ~/.cache/obs holding symlinks to just its markdown and images.
set -euo pipefail
# --here: open dir itself as the vault (a notes vault you write in, e.g. ~/wiki), linking the shared config into its .obsidian.
here=; [ "${1:-}" = --here ] && { here=1; shift; }

# ob <file>: open that file, in its git root (else its folder) as the vault.
if [ $# -eq 1 ] && [ -f "$1" ]; then
  f=$(realpath "$1"); d=$(dirname "$f")
  r=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null || echo "$d")
  set -- "$r" "${f#"$r"/}"
fi
root=$(realpath "${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}")
[ -d "$root" ] || { echo "ob: not a directory: $root" >&2; exit 1; }
[ "$root" != "$HOME" ] || { echo "ob: refusing to open \$HOME as a vault" >&2; exit 1; }
open_file=${2:-}
case $open_file in /* | *..*) echo "ob: file must be relative to $root: $open_file" >&2; exit 1 ;; esac
shared=$(realpath "$(dirname "$(readlink -f "$0")")/../config/obsidian")
reg="${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json"
sock="${XDG_RUNTIME_DIR:-$HOME}/.obsidian-cli.sock"
vault="${XDG_CACHE_HOME:-$HOME/.cache}/obs/$(printf %s "$root" | sha1sum | cut -c1-8)/$(basename "$root")"
[ -z "$here" ] || vault=$root

list_docs() {
  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$root" ls-files -z -co --exclude-standard
  else
    find "$root" \( -name .git -o -name node_modules -o -name .venv -o -name vendor -o -name target -o -name dist -o -name build \) -prune \
      -o -type f -printf '%P\0'
  fi | grep -zaiE '\.(md|markdown|png|jpe?g|gif|svg|webp)$' || true
}

# Sync mirror: link new docs (and the other files they link to, e.g. a plan's scripts/x.py, so those links work),
# drop links whose target is gone, prune emptied dirs.
# Dot-folders (.claude/, .agents/) are mirrored as-is; the shared "unhide" plugin makes Obsidian show them.
mkdir -p "$vault/.obsidian"
[ -n "$here" ] || while IFS= read -r -d '' rel; do
  dst="$vault/$rel"
  [ -L "$dst" ] && continue
  mkdir -p "$(dirname "$dst")" && ln -s "$root/$rel" "$dst"
done < <(list_docs; list_docs | grep -zaiE '\.(md|markdown)$' | "$(dirname "$(readlink -f "$0")")/md-link-targets" "$root")
[ -n "$here" ] || find "$vault" -xtype l -delete
[ -n "$here" ] || find "$vault" -mindepth 1 -type d -empty -not -path "$vault/.obsidian" -delete

# Config: project's own real .obsidian files win, shared dotfiles config fills the rest; workspace.json stays per-vault.
# Plugins always come from dotfiles: community plugins get auto-enabled below, so never run JS a repo ships.
for src in "$root"/.obsidian/* "$shared"/*; do
  [ -e "$src" ] && ! [ -L "$src" ] || continue
  case "$src" in "$root"/.obsidian/plugins | "$root"/.obsidian/community-plugins.json) continue ;; esac
  case "$(basename "$src")" in workspace*.json | *.base) continue ;; esac
  dst="$vault/.obsidian/$(basename "$src")"
  [ -e "$dst" ] || ln -sfn "$src" "$dst"  # -e is false for a dangling link (e.g. dotfiles moved), so it gets repointed
done
# Plans dashboard (Bases view over plan front matter) for projects with the docs/plans layout.
[ -d "$root/docs/plans" ] && ! [ -e "$vault/Plans.base" ] && ln -sfn "$shared/plans.base" "$vault/Plans.base"

# Write-back: the mirror's paths are the truth. A note made in Obsidian is a real file in the mirror (lost with the
# cache, and the next sync never sees it): move it into the project and link it back. A link renamed or moved in
# Obsidian moves its target to match. Never overwrites a project file; .obsidian and .trash stay in the mirror.
adopt() {
  local p rel want t tmp
  tmp="$(dirname "$vault")/adopt.tmp"  # same filesystem as the mirror, so the swap below is one atomic rename
  find "$vault" \( -path "$vault/.obsidian" -o -path "$vault/.trash" \) -prune -o \
    \( -type l -o -type f -not -newer "$stamp" \) -print0 | while IFS= read -r -d '' p; do
    rel=${p#"$vault"/}; want="$root/$rel"
    if [ -L "$p" ]; then
      t=$(readlink "$p")
      [ "$t" != "$want" ] && [ -e "$t" ] && ! [ -e "$want" ] || continue
      case $t in "$root"/*) ;; *) continue ;; esac  # e.g. Plans.base links to dotfiles
      mkdir -p "$(dirname "$want")" && mv -n "$t" "$want" || continue
    else
      # shortcut: a save landing between this copy and the swap is lost; files untouched for one poll (2s) only
      ! [ -e "$want" ] && mkdir -p "$(dirname "$want")" && cp -p "$p" "$want" || continue
    fi
    ln -sfn "$want" "$tmp" && mv -fT "$tmp" "$p"
  done
}

# Edits to link targets fire no watcher events inside the vault; touching the link does. Poll the ~hundreds of
# targets (cheap) and stop once Obsidian quits. One poller per vault.
pidf="$(dirname "$vault")/poll.pid"
[ -n "$here" ] || { [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null || true
( trap '' HUP  # survive the terminal closing
  stamp="$(dirname "$vault")/poll.stamp"; touch "$stamp"
  while sleep 2 && pgrep -f '/obsidian/app.asar' >/dev/null; do
    adopt
    touch "$stamp.next"
    find -L "$vault" -path "$vault/.obsidian" -prune -o -type f -newer "$stamp" -print0 | xargs -0r touch -h
    mv "$stamp.next" "$stamp"
  done
) >/dev/null 2>&1 &
echo $! >"$pidf"; }

# Open + verify runs detached so the shell returns at once; errors arrive as desktop notifications.
fail() { notify-send -a ob "ob" "$1" 2>/dev/null || echo "ob: $1" >&2; return 1; }
# A mirror vault's plugins are the dotfiles' own (linked above, never a repo's), so trust it up front instead of
# Obsidian asking "Do you trust the author of this vault?" for every new one (each worktree is a new vault).
# Obsidian keeps that answer in its localStorage as enable-plugin-<vault id>, shared by all its windows.
trust_js=""
[ -n "$here" ] || trust_js="for (const [id, v] of Object.entries(window.electron.ipcRenderer.sendSync('vault-list'))) if (v.path === $(jq -n --arg p "$vault" '$p')) localStorage.setItem('enable-plugin-' + id, 'true');"
open_vault() {
  if [ -S "$sock" ]; then
    # Running app keeps its vault list in memory and ignores obsidian.json edits, so register through it:
    # "vault-open" is the same IPC as "Open folder as vault" (adds the vault if new, then opens it).
    # trust before opening (a known vault) and right after (a new one gets its id here; its window is still loading)
    out=$(obsidian eval "code=$trust_js const r = window.electron.ipcRenderer.sendSync('vault-open', $(jq -n --arg p "$vault" '$p'), false); $trust_js r" 2>&1) || true
    case "$out" in *"not enabled"*)
      fail "enable Settings > General > Advanced > Command line interface, then rerun" ;;
    esac
  else
    # Not running: the registry is read at startup, so writing it is safe. cli=true lets the branch above work next time.
    [ -f "$reg" ] || { mkdir -p "$(dirname "$reg")"; echo '{"vaults":{}}' >"$reg"; }
    tmp=$(mktemp)
    jq --arg id "$(openssl rand -hex 8)" --arg p "$vault" --argjson ts "$(date +%s%3N)" \
      '.cli = true | if any(.vaults[]; .path == $p) then . else .vaults[$id] = {path: $p, ts: $ts} end' \
      "$reg" >"$tmp" && mv "$tmp" "$reg"
    out=""
    setsid obsidian "obsidian://open?path=$(jq -rn --arg p "$vault" '$p | @uri')" >/dev/null 2>&1 &
  fi

  # Wait until the vault is live (eval output is often empty once a new window takes focus, so check the vault list).
  # The socket check stops us calling the CLI before the app is up, which would spawn a second launch.
  live() { [ -S "$sock" ] && obsidian vaults verbose 2>/dev/null | cut -f2- | grep -qxF "$vault"; }
  for _ in $(seq 40); do
    if live; then
      # cold start (no app to trust it through first): it opened asking; trust it and reload, which drops the question
      [ -n "$here" ] || obsidian vault="$(basename "$vault")" eval code="if (!app.plugins.isEnabled()) { localStorage.setItem('enable-plugin-' + app.appId, 'true'); location.reload(); }" >/dev/null 2>&1
      if [ -n "$open_file" ]; then
        xdg-open "obsidian://open?path=$(jq -rn --arg p "$vault/$open_file" '$p | @uri')"
        # once it is the active file: collapse the file explorer, then expand just the folders leading to it
        name=$(basename "$vault")
        for _ in $(seq 10); do
          [ "$(obsidian vault="$name" file 2>/dev/null | awk -F'\t' '$1 == "path" { print $2 }')" = "$open_file" ] && break
          sleep 0.3
        done
        obsidian vault="$name" eval code="const v = app.workspace.getLeavesOfType('file-explorer')[0]?.view;
          const f = app.vault.getAbstractFileByPath($(jq -n --arg p "$open_file" '$p'));
          if (v && f) { v.tree.setCollapseAll(true); v.revealInFolder(f); }" >/dev/null 2>&1
      fi
      # niri does not raise an already-running app on its own; bring Obsidian to the front
      win=$(niri msg -j windows 2>/dev/null | jq -r 'first(.[] | select(.app_id == "md.obsidian.Obsidian") | .id) // empty')
      [ -z "$win" ] || niri msg action focus-window --id "$win"
      return 0
    fi
    sleep 0.5
  done
  fail "failed to open $vault${out:+: $out}"
}
( trap '' HUP; open_vault ) </dev/null >/dev/null 2>&1 &
