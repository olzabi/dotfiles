#!/usr/bin/env bash
# One merged herdr sidebar: each open workspace as a header, its agents (status · branch) under it.
# Click/Enter on a workspace collapses/expands it; on an agent focuses that agent in herdr.
# Runs as a kitty split beside herdr (not a herdr pane) so it survives herdr workspace switches.
# Usage: herdr-tree            interactive tree (refreshes every 2s)
#        herdr-tree list       print the tree rows (kind<TAB>id<TAB>display)
#        herdr-tree act K ID   click action for a row
#        herdr-tree toggle     close the tree split, or open it on the left inside herdr's kitty window (niri Mod+A)
set -u
state=${XDG_RUNTIME_DIR:-/tmp}/herdr-tree.collapsed

list() {
  touch "$state"
  herdr api snapshot 2>/dev/null | jq -r --rawfile collapsed "$state" '
    def c($hex): "\u001b[38;2;\($hex[1:3]|ascii_downcase|explode|map(if .>96 then .-87 else .-48 end)|.[0]*16+.[1]);\($hex[3:5]|ascii_downcase|explode|map(if .>96 then .-87 else .-48 end)|.[0]*16+.[1]);\($hex[5:7]|ascii_downcase|explode|map(if .>96 then .-87 else .-48 end)|.[0]*16+.[1])m";
    def r: "\u001b[0m";
    def icon: {working: (c("#ffffba")+"●"), blocked: (c("#dea6a0")+"▲"), done: (c("#7fa1c3")+"◆"),
               idle: (c("#baffc9")+"○")}[.] // (c("#585858")+"·");
    .result.snapshot as $s
    | ($collapsed | split("\n")) as $closed
    | $s.workspaces | sort_by(.number)[]
    | . as $w
    | ($closed | index($w.workspace_id)) as $isClosed
    | [$s.panes[] | select(.workspace_id == $w.workspace_id and .agent != null)] as $agents
    | ( "ws\t\($w.workspace_id)\t"
        + (if $isClosed then "▸ " else "▾ " end)
        + ($w.agent_status | icon) + r + " "
        + (if $w.workspace_id == $s.focused_workspace_id then "\u001b[1m" + c("#83b7ad") else "\u001b[1m" end)
        + $w.label + r
        + (if $isClosed and ($agents|length) > 0 then c("#585858") + " (\($agents|length))" + r else "" end) ),
      ( if $isClosed then empty else
          $agents[]
          | "agent\t\(.pane_id)\t    " + (.agent_status | icon) + " " + .agent_status + r
            + c("#585858") + " · " + (.tokens.branch // "—") + r
        end )
  '
}

case ${1:-} in
  list) list ;;
  act)
    case ${2:-} in
      ws) grep -qxF -- "$3" "$state" 2>/dev/null && sed -i "/^$3\$/d" "$state" || echo "$3" >> "$state" ;;
      agent) herdr agent focus "$3" >/dev/null 2>&1 ;;
    esac ;;
  toggle)
    # herdr's kitty (niri app-id "herdr") listens on unix:@kitty-<pid> (kitty.conf listen_on)
    pid=$(niri msg -j windows | jq -r 'first(.[] | select(.app_id == "herdr") | .pid) // empty')
    [ -n "$pid" ] || exit 1
    to=unix:@kitty-$pid
    kitty @ --to "$to" close-window --match var:herdr_tree >/dev/null 2>&1 && exit 0
    kitty @ --to "$to" goto-layout splits
    # splits + before: new window on the left of herdr; bias = its share of the width (%)
    exec kitty @ --to "$to" launch --type=window --location=before --keep-focus --bias=18 \
      --var herdr_tree=1 --title herdr-tree "$(readlink -f "$0")" >/dev/null ;;
  *)
    command -v herdr >/dev/null || { echo "herdr not found"; exit 1; }
    self=$(readlink -f "$0")
    FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE= exec fzf --ansi --no-input --no-info --no-sort --no-scrollbar --layout=reverse \
      --delimiter='\t' --with-nth=3 --track --id-nth=2 \
      --pointer=' ' --marker=' ' --no-separator --border=none \
      --color='bg+:#303030,gutter:-1,hl:-1,hl+:-1' --gutter=' ' \
      --bind "start,every(2):reload-sync($self list)" \
      --bind "left-click,double-click,enter:execute-silent($self act {1} {2})+reload($self list)" \
      --bind 'esc:ignore,ctrl-c:abort,q:abort' ;;
esac
