#!/usr/bin/env bash
# Report the calling herdr pane's VCS position as the sidebar token $branch:
#   git: current branch (short sha when detached)   jj: "jj bookmark@change"
# Pane-scoped on purpose: parallel agents in different worktrees of one workspace never overwrite each other.
# Usage: herdr-vcs [dir]   (no-op outside herdr; called from agent hooks with the agent's cwd)
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
cd "${1:-$PWD}" 2>/dev/null || exit 0
src=dotfiles:vcs

if jj root --ignore-working-copy >/dev/null 2>&1; then
  # nearest bookmark on @ or its ancestors, plus @'s short change id
  bm=$(jj log -r 'latest(::@ & bookmarks())' --no-graph --ignore-working-copy -T 'bookmarks.join(",")' 2>/dev/null)
  ch=$(jj log -r @ --no-graph --ignore-working-copy -T 'change_id.shortest(4)' 2>/dev/null)
  branch="jj ${bm:+$bm@}$ch"
elif git rev-parse --git-dir >/dev/null 2>&1; then
  branch=$(git branch --show-current 2>/dev/null)
  [ -n "$branch" ] || branch=$(git rev-parse --short HEAD 2>/dev/null)
fi

if [ -n "${branch:-}" ]; then
  herdr pane report-metadata "$HERDR_PANE_ID" --source "$src" --token "branch=$branch" >/dev/null 2>&1
else
  herdr pane report-metadata "$HERDR_PANE_ID" --source "$src" --clear-token branch >/dev/null 2>&1
fi
exit 0
