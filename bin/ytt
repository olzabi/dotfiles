#!/usr/bin/env bash
# yt-transcript.sh - save a YouTube transcript as an Obsidian note.
#
# Usage: ./yt-transcript.sh <URL> [lang]
#   Output: <OUT_DIR>/<Video title>.md  (YAML properties + tags + transcript)
#
# Env:
#   OUT_DIR=dir       where to save notes (default: current dir, e.g. your vault folder)
#   TAGS="a,b"        extra Obsidian tags to add
#   FORCE=1           overwrite an existing note
#   ASR_ONLY=1        skip subtitles, always transcribe audio (needs transcribe.py)
#   NO_ASR=1          never fall back to audio transcription
#   WPM_MIN=70        words/min below which captions count as incomplete (0 disables)
#   YTDLP_EXTRA="--cookies-from-browser firefox"   extra yt-dlp flags
#   TRANSCRIBE_PY=path  explicit path to transcribe.py (Whisper fallback)
#   PYTHON_BIN=python3  interpreter used for transcribe.py (e.g. a venv's python)
#
# transcribe.py is searched in: $TRANSCRIBE_PY, next to this script (symlinks
# are followed), then ~/.local/share/yt-transcript/transcribe.py
set -euo pipefail

OUT_DIR="${OUT_DIR:-$HOME/Media/Documents/research}"
url="${1:?usage: $0 <URL> [lang]}"
lang="${2:-en}"
WPM_MIN="${WPM_MIN:-70}"
out="${OUT_DIR:-.}"
dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
read -r -a YX <<<"${YTDLP_EXTRA:-}"

for cmd in yt-dlp python3; do
  command -v "$cmd" >/dev/null || { echo "Missing dependency: $cmd" >&2; exit 1; }
done

mkdir -p "$out"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# ---- python helper: filename, VTT cleaning, note formatting ----
cat >"$tmp/helper.py" <<'PY'
import datetime, html, json, os, re, sys

sys.stdout.reconfigure(encoding="utf-8")


def safe_name(title, fallback):
    t = re.sub(r'[\x00-\x1f\\/:*?"<>|#^\[\]]', "", title)
    t = re.sub(r"\s+", " ", t).strip(" .")[:120].rstrip(" .")
    return t or fallback


def slug_tag(s):
    s = re.sub(r"[^\w/-]+", "-", s.strip().lower(), flags=re.UNICODE)
    s = re.sub(r"-+", "-", s).strip("-")
    if s and not re.search(r"\D", s):  # Obsidian tags can't be purely numeric
        s = "tag-" + s
    return s


def clean_vtt(path):
    out, prev = [], ""
    skip = ("WEBVTT", "Kind:", "Language:", "NOTE", "STYLE")
    for raw in open(path, encoding="utf-8", errors="replace"):
        line = raw.strip()
        if not line or "-->" in line or line.startswith(skip):
            continue
        line = html.unescape(re.sub(r"<[^>]+>", "", line))
        line = re.sub(r"\s+", " ", line).strip()
        if line and line != prev:  # auto-captions repeat rolling lines
            out.append(line)
            prev = line
    return " ".join(out)


def paragraphs(text, target=90, hard=150):
    paras, cur = [], []
    for w in text.split():
        cur.append(w)
        if (len(cur) >= target and w[-1] in ".?!") or len(cur) >= hard:
            paras.append(" ".join(cur))
            cur = []
    if cur:
        paras.append(" ".join(cur))
    return "\n\n".join(paras)


def note(meta_path, txt_path, src, lang, url):
    m = json.load(open(meta_path, encoding="utf-8"))
    text = open(txt_path, encoding="utf-8").read().strip()
    if "\n\n" not in text:
        text = paragraphs(" ".join(text.split()))

    title = m.get("title") or "Untitled"
    channel = m.get("channel") or m.get("uploader") or ""
    ud = m.get("upload_date") or ""
    uploaded = f"{ud[:4]}-{ud[4:6]}-{ud[6:]}" if len(ud) == 8 else ""
    h, r = divmod(int(m.get("duration") or 0), 3600)
    mi, s = divmod(r, 60)
    duration = f"{h}:{mi:02d}:{s:02d}" if h else f"{mi}:{s:02d}"
    link = m.get("webpage_url") or url

    tags = ["youtube", "transcript", slug_tag(channel)]
    tags += [slug_tag(t) for t in os.environ.get("TAGS", "").split(",")]
    tags = list(dict.fromkeys(t for t in tags if t))

    q = lambda v: json.dumps(v, ensure_ascii=False)  # JSON string == valid YAML string
    fm = ["---", f"title: {q(title)}", f"source: {q(link)}"]
    if channel:
        fm.append(f"channel: {q(channel)}")
    if uploaded:
        fm.append(f"uploaded: {uploaded}")
    fm += [
        f"duration: {q(duration)}",
        f"video_id: {q(m.get('id') or '')}",
        f"language: {q(lang)}",
        f"transcript_source: {src}",
        f"created: {datetime.date.today().isoformat()}",
        "tags:",
        *[f"  - {t}" for t in tags],
        "---",
    ]
    print("\n".join(fm))
    print(f"\n# {title}\n\n[Watch on YouTube]({link})\n\n## Transcript\n\n{text}")


if __name__ == "__main__":
    cmd = sys.argv[1]
    if cmd == "name":
        meta = json.load(open(sys.argv[2], encoding="utf-8"))
        print(safe_name(meta.get("title") or "", meta.get("id") or "video"))
    elif cmd == "hint":
        meta = json.load(open(sys.argv[2], encoding="utf-8"))
        print(". ".join(x for x in (meta.get("title"), meta.get("channel")) if x))
    elif cmd == "duration":
        meta = json.load(open(sys.argv[2], encoding="utf-8"))
        print(int(meta.get("duration") or 0))
    elif cmd == "clean":
        print(clean_vtt(sys.argv[2]))
    elif cmd == "note":
        note(*sys.argv[2:7])
PY
helper() { python3 "$tmp/helper.py" "$@"; }

# ---- metadata ----
yt-dlp --skip-download --no-playlist --quiet --no-warnings \
  ${YX[@]+"${YX[@]}"} -J "$url" >"$tmp/meta.json" || {
  echo "Could not fetch video metadata." >&2
  exit 1
}

name="$(helper name "$tmp/meta.json")"
file="$out/$name.md"

if [ -s "$file" ] && [ "${FORCE:-0}" != "1" ]; then
  echo "Already exists: $file (FORCE=1 to overwrite)" >&2
  exit 0
fi

dur="$(helper duration "$tmp/meta.json")"
VIDEO_META="$(helper hint "$tmp/meta.json")" # spelling hint for Whisper (see transcribe.py)
export VIDEO_META

# ---- fetchers ----
get_subs() { # $1 = output text file
  yt-dlp --skip-download --no-playlist --quiet --no-warnings --sleep-requests 1 \
    ${YX[@]+"${YX[@]}"} --write-subs --write-auto-subs --sub-format vtt \
    --sub-langs "$lang,$lang-.*" -P "$tmp" -o "subs.%(ext)s" "$url" >/dev/null 2>&1 || true
  local f="$tmp/subs.$lang.vtt" c
  if [ ! -s "$f" ]; then
    f=""
    for c in "$tmp"/subs.*.vtt; do
      if [ -s "$c" ]; then f="$c"; break; fi
    done
  fi
  [ -n "$f" ] || return 1
  helper clean "$f" >"$1"
  [ -s "$1" ]
}

find_transcriber() {
  local c
  for c in "${TRANSCRIBE_PY:-}" "$dir/transcribe.py" "$HOME/.local/share/yt-transcript/transcribe.py"; do
    if [ -n "$c" ] && [ -f "$c" ]; then printf '%s' "$c"; return 0; fi
  done
  return 1
}

get_asr() { # $1 = output text file
  local tpy
  tpy="$(find_transcriber)" || { echo "transcribe.py not found (set TRANSCRIBE_PY)." >&2; return 1; }
  yt-dlp -f bestaudio --no-playlist --quiet --no-warnings --no-progress \
    ${YX[@]+"${YX[@]}"} -o "$tmp/audio.%(ext)s" "$url" >&2 || return 1
  local py="${PYTHON_BIN:-python3}" nv
  # Find CUDA 12 runtime libs (pip nvidia-* wheels or a system toolkit) and expose them to the loader.
  nv="$("$py" - <<'PY' || true
import glob, importlib.util, os, sys
try:
    pip_roots, sys_roots = [], []
    spec = importlib.util.find_spec("nvidia")
    if spec:
        pip_roots += list(spec.submodule_search_locations or [])
    for pat in ("/usr/local/cuda*/lib64", "/usr/local/cuda*/targets/*/lib", "/opt/cuda*/lib64"):
        sys_roots += glob.glob(pat)

    def find(pattern):
        hits = []
        for r in pip_roots:
            hits += glob.glob(os.path.join(r, "**", pattern), recursive=True)
        for r in sys_roots:
            hits += glob.glob(os.path.join(r, pattern))
        return sorted(set(hits))

    cublas12, cudnn9 = find("libcublas.so.12*"), find("libcudnn.so.9*")
    if not cublas12:
        other = [os.path.basename(h) for h in find("libcublas.so.*")]
        print("libcublas.so.12 not found for %s%s" % (
            sys.executable,
            " (only %s: wrong CUDA version, install nvidia-cublas-cu12)" % ", ".join(other) if other
            else " (pip install nvidia-cublas-cu12 nvidia-cudnn-cu12 into this Python)"), file=sys.stderr)
    if not cudnn9:
        print("libcudnn.so.9 not found (pip install nvidia-cudnn-cu12)", file=sys.stderr)
    print(":".join(dict.fromkeys(os.path.dirname(h) for h in cublas12 + cudnn9)))
except Exception as e:
    print("CUDA lib lookup failed: %s" % e, file=sys.stderr)
PY
)"
  if [ -n "$nv" ]; then
    export LD_LIBRARY_PATH="$nv${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    echo "CUDA libs: $nv" >&2
  fi
  local a audio=""
  for a in "$tmp"/audio.*; do
    if [ -f "$a" ]; then audio="$a"; break; fi
  done
  [ -n "$audio" ] || return 1
  echo "Using $tpy" >&2
  "$py" "$tpy" "$audio" "${lang%%[-.*]*}" >"$1" || return 1
  [ -s "$1" ]
}

# ---- pick the best transcript ----
subs="$tmp/subs.txt"
asr="$tmp/asr.txt"
final=""
src=""
need_asr=0

if [ "${ASR_ONLY:-0}" = "1" ]; then
  need_asr=1
elif get_subs "$subs"; then
  final="$subs"
  src="subtitles"
  words=$(wc -w <"$subs")
  wpm=$((dur > 0 ? words * 60 / dur : -1))
  echo "Subtitles: $words words, $wpm words/min" >&2
  if ((WPM_MIN > 0 && wpm >= 0 && wpm < WPM_MIN)); then
    echo "WARNING: captions look incomplete (under $WPM_MIN words/min)." >&2
    need_asr=1
  fi
else
  echo "No subtitles available." >&2
  need_asr=1
fi

if [ "$need_asr" = "1" ] && [ "${NO_ASR:-0}" != "1" ]; then
  echo "Transcribing audio (Whisper)..." >&2
  if get_asr "$asr"; then
    if [ -z "$final" ] || [ "$(wc -w <"$asr")" -gt "$(wc -w <"$final")" ]; then
      final="$asr"
      src="whisper"
    fi
  else
    echo "Audio transcription failed." >&2
  fi
fi

if [ -z "$final" ]; then
  echo "No transcript could be obtained." >&2
  exit 1
fi

# ---- write the note ----
helper note "$tmp/meta.json" "$final" "$src" "$lang" "$url" >"$file"
echo "Saved ($src, $(wc -w <"$final") words): $file" >&2
