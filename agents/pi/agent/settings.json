{
  "lastChangelogVersion": "1.3.0",
  "collapseChangelog": true,
  "autoUpdate": true,
  "quietStartup": true,
  "defaultProvider": "openai",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "xhigh",
  "modelThinkingLevels": {
    "openai/gpt-6-luna": "xhigh",
    "openai/gpt-6.1-sol": "medium"
  },
  "theme": "darkvoid",
  "markdown": {
    "mermaid": "streaming"
  },
  "hideThinkingBlock": true,
  "enabledModels": [
    "ollama/qwen3.5:latest",
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol",
    "openai/gpt-6-astra"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@tintinweb/pi-subagents",
    "npm:@tintinweb/pi-tasks",
    "npm:@narumitw/pi-usage",
    "npm:context-mode",
    "npm:pi-mcp-adapter",
    "npm:pi-observational-memory",
    "npm:pi-context-prune",
    "npm:pi-memory",
    "npm:pi-lens",
    "npm:pi-rtk-optimizer",
    "npm:pi-web-access",
    "npm:pi-cache-optimizer",
    "npm:pi-minimalist",
    "npm:pi-vim",
    "./extensions/.packages/pi-atelier-local",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "tuiMode": "regular",
  "outputPad": 1,
  "images": {
    "blockImages": false
  },
  "enableSkillCommands": true,
  "editorPaddingX": 0,
  "terminal": {
    "clearOnShrink": false
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "transport": "auto",
  "httpIdleTimeoutMs": 120000,
  "showCacheMissNotices": true,
  "showWorkerNotifications": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "fullscreenExitOutput": "transcript",
  "extensions": [
    "-builtin:mcp"
  ],
  "minimalist": {
    "preset": "lite",
    "compactToolRows": true,
    "groupToolRuns": true,
    "foldIntermediateActivity": false,
    "thinkingAsToolCall": true,
    "activitySummary": "elapsed",
    "gutter": true,
    "timer": true,
    "keepActiveToolsExpanded": false,
    "glyphStyle": "unicode",
    "excludeTools": [],
    "keepActiveThinkingExpanded": false
  },
  "piVim": {
    "clipboardMirror": "all",
    "exCommand": {
      "piDispatch": true,
      "copyInputToClipboard": false
    },
    "modeColors": {
      "insert": "borderMuted",
      "normal": "borderAccent",
      "visual": "customMessageLabel",
      "ex": "warning"
    },
    "borderSync": {
      "insert": "host",
      "normal": "host",
      "visual": "host",
      "ex": "host"
    },
    "labelSync": {
      "insert": "mode",
      "normal": "mode",
      "visual": "mode",
      "ex": "mode"
    }
  },
  "observational-memory": {
    "observeAfterTokens": 15000,
    "reflectAfterTokens": 30000,
    "compactAfterTokens": 100000,
    "compactAfterTokensMode": "callibrated",
    "compactAfterTokensRatio": 0.68,
    "observationsPoolMaxTokens": 20000,
    "agentMaxTurns": 16,
    "models": {
      "consolidator": {
        "provider": "openai",
        "id": "gpt-6-luna",
        "thinking": "high"
      },
      "observer": {
        "provider": "openai",
        "id": "gpt-6-luna",
        "thinking": "high"
      }
    },
    "passive": false,
    "debugLog": false
  }
}
