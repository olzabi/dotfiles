
# author: based on darkvoid.nvim by aliqyan-21
# https://github.com/darkvoid-theme/darkvoid.nvim
[delta "darkvoid"]
    dark = true
    line-numbers = true

    # ── Syntax highlighting ────────────────────────────────────────────────────
    # Uses bat's darkvoid theme (bat cache --build)
    syntax-theme = darkvoid
    file-style = omit
    file-decoration-style = none
    commit-decoration-style = bold box ul "#1c1c1c"

    # ── Hunk header ────────────────────────────────────────────────────────────
    # dim comment-grey text, neon green line-number, box in dark bg
    hunk-header-style = file line-number syntax
    hunk-header-file-style = "#585858"
    hunk-header-line-number-style = bold "#1bfd9c"
    hunk-header-decoration-style = "#303030" box ul

    # ── Line numbers ───────────────────────────────────────────────────────────
    line-numbers-left-style  = "#404040"
    line-numbers-right-style = "#404040"
    line-numbers-zero-style  = "#585858"
    # removed lines: soft red gutter
    line-numbers-minus-style = bold "#ffb3ba"
    # added lines: soft green gutter
    line-numbers-plus-style  = bold "#baffc9"

    # ── Removed lines ──────────────────────────────────────────────────────────
    # subtle dark red background, brighter red for changed word
    minus-style      = normal "#2a1018"
    minus-emph-style = normal "#4a1020"

    # ── Added lines ────────────────────────────────────────────────────────────
    # subtle dark green background, brighter green for changed word
    plus-style      = syntax "#0d2010"
    plus-emph-style = syntax "#1a3a18"

    # ── Moved lines ────────────────────────────────────────────────────────────
    map-styles = \
        bold purple => syntax "#303030", \
        bold blue   => syntax "#252525"

    # ── Misc ───────────────────────────────────────────────────────────────────
    zero-style = syntax
    whitespace-error-style = "#1bfd9c" reverse
    blame-palette = "#1c1c1c" "#222222" "#252525" "#282828"

