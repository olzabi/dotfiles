[include]
  path = darkvoid.gitconfig

[core]
  pager = delta

[delta]
  navigate = true
  line-numbers = true
  decorations = true
  white-space-error-style = 22 reverse

[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta

[interactive]
  diffFilter = delta --color-only --features=interactive

