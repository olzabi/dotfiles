[include]
	 path = user.gitconfig
	 path = delta.gitconfig
	 path = aliases.gitconfig

[core]
	editor = nvim
	whitespace      = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[init]
	defaultBranch = dev

[fetch]
	prune = false
	prunetags = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[merge]
  ff = false
  conflictStyle = zdiff3

[rebase]
	authstash = true
	autosquash = true
	updateRefs = true

[credential]
	helper = osxkeychain

[url "git@github.com:"]
insteadOf = https://github.com/

