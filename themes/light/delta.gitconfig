
# author: based on darkvoid.nvim by aliqyan-21
# https://github.com/darkvoid-theme/darkvoid.nvim
[delta "darkvoid"]
    light = true
    line-numbers = true

    # ── Syntax highlighting ────────────────────────────────────────────────────
    # Uses bat's darkvoid theme (bat cache --build)
    syntax-theme = darkvoid-light
    file-style = omit
    file-decoration-style = none
    commit-decoration-style = bold box ul "#d3ceca"

    # ── Hunk header ────────────────────────────────────────────────────────────
    # dim comment-grey text, neon green line-number, box in dark bg
    hunk-header-style = file line-number syntax
    hunk-header-file-style = "#77736f"
    hunk-header-line-number-style = bold "#005d2a"
    hunk-header-decoration-style = "#bab6b1" box ul

    # ── Line numbers ───────────────────────────────────────────────────────────
    line-numbers-left-style  = "#a09b97"
    line-numbers-right-style = "#a09b97"
    line-numbers-zero-style  = "#77736f"
    # removed lines: soft red gutter
    line-numbers-minus-style = bold "#913948"
    # added lines: soft green gutter
    line-numbers-plus-style  = bold "#00581b"

    # ── Removed lines ──────────────────────────────────────────────────────────
    # subtle dark red background, brighter red for changed word
    minus-style      = normal "#dcbac3"
    minus-emph-style = normal "#dbb8bd"

    # ── Added lines ────────────────────────────────────────────────────────────
    # subtle dark green background, brighter green for changed word
    plus-style      = syntax "#d3ceca"
    plus-emph-style = syntax "#acc1aa"

    # ── Moved lines ────────────────────────────────────────────────────────────
    map-styles = \
        bold purple => syntax "#bab6b1", \
        bold blue   => syntax "#c8c3bf"

    # ── Misc ───────────────────────────────────────────────────────────────────
    zero-style = syntax
    whitespace-error-style = "#005d2a" reverse
    blame-palette = "#d3ceca" "#ccc7c3" "#c8c3bf" "#c4c0bc"

