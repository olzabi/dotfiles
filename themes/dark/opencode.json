{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":          "#1c1c1c",
    "bgPanel":     "#242424",
    "bgElement":   "#2a2a2a",
    "bgVisual":    "#303030",
    "fg":          "#c0c0c0",
    "fgDim":       "#b1b1b1",
    "fgMuted":     "#585858",
    "lineNr":      "#404040",
    "comment":     "#585858",
    "string":      "#d1d1d1",
    "func":        "#e1e1e1",
    "kw":          "#f1f1f1",
    "type":        "#a1a1a1",
    "typeBuiltin": "#c5c5c5",
    "identifier":  "#b1b1b1",
    "bracket":     "#e6e6e6",
    "constant":    "#b2d8d8",
    "bool":        "#66b2b2",
    "preprocessor":"#4b8902",
    "glowGreen":   "#1bfd9c",
    "cursor":      "#bdfe58",
    "added":       "#baffc9",
    "changed":     "#ffffba",
    "removed":     "#ffb3ba",
    "border":      "#2e2e2e",
    "borderActive":"#404040",
    "bgLight": "#c6c4c0",
    "bgPanelLight": "#bdbbb8",
    "bgElementLight": "#b6b4b1",
    "bgVisualLight": "#aeaca9",
    "fgLight": "#393734",
    "fgDimLight": "#41403d",
    "fgMutedLight": "#787673",
    "lineNrLight": "#9c9a97",
    "commentLight": "#787673",
    "stringLight": "#32302d",
    "funcLight": "#2a2926",
    "kwLight": "#23211e",
    "typeLight": "#4b4946",
    "typeBuiltinLight": "#373532",
    "identifierLight": "#41403d",
    "bracketLight": "#282623",
    "constantLight": "#335556",
    "boolLight": "#056162",
    "preprocessorLight": "#486236",
    "glowGreenLight": "#23573a",
    "cursorLight": "#3e5123",
    "addedLight": "#265333",
    "changedLight": "#4c4a13",
    "removedLight": "#784249",
    "borderLight": "#b1afac",
    "borderActiveLight": "#9c9a97"
  },
  "theme": {
    "primary":    { "dark": "glowGreen",   "light": "glowGreenLight" },
    "secondary":  { "dark": "bool",        "light": "boolLight" },
    "accent":     { "dark": "cursor",      "light": "cursorLight" },
    "error":      { "dark": "removed",     "light": "removedLight" },
    "warning":    { "dark": "changed",     "light": "changedLight" },
    "success":    { "dark": "added",       "light": "addedLight" },
    "info":       { "dark": "bool",        "light": "boolLight" },

    "text":            { "dark": "fg",        "light": "fgLight" },
    "textMuted":       { "dark": "fgMuted",   "light": "fgMutedLight" },
    "background":      { "dark": "bg",        "light": "bgLight" },
    "backgroundPanel": { "dark": "bgPanel",   "light": "bgPanelLight" },
    "backgroundElement":{ "dark": "bgElement","light": "bgElementLight" },
    "border":          { "dark": "border",    "light": "borderLight" },
    "borderActive":    { "dark": "borderActive","light": "borderActiveLight" },
    "borderSubtle":    { "dark": "border",    "light": "borderLight" },

    "diffAdded":              { "dark": "added",     "light": "addedLight" },
    "diffRemoved":            { "dark": "removed",   "light": "removedLight" },
    "diffContext":            { "dark": "fgMuted",   "light": "fgMutedLight" },
    "diffHunkHeader":         { "dark": "lineNr",    "light": "lineNrLight" },
    "diffHighlightAdded":     { "dark": "glowGreen", "light": "glowGreenLight" },
    "diffHighlightRemoved":   { "dark": "removed",   "light": "removedLight" },
    "diffAddedBg":            { "dark": "#1e2a1e",   "light": "#abbaab" },
    "diffRemovedBg":          { "dark": "#2a1e1e",   "light": "#c5b4b4" },
    "diffContextBg":          { "dark": "bgPanel",   "light": "bgPanelLight" },
    "diffLineNumber":         { "dark": "lineNr",    "light": "lineNrLight" },
    "diffAddedLineNumberBg":  { "dark": "#1c2a1c",   "light": "#aabba9" },
    "diffRemovedLineNumberBg":{ "dark": "#2a1c1c",   "light": "#c8b4b4" },

    "markdownText":           { "dark": "fg",         "light": "fgLight" },
    "markdownHeading":        { "dark": "glowGreen",  "light": "glowGreenLight" },
    "markdownLink":           { "dark": "bool",       "light": "boolLight" },
    "markdownLinkText":       { "dark": "constant",   "light": "constantLight" },
    "markdownCode":           { "dark": "string",     "light": "stringLight" },
    "markdownBlockQuote":     { "dark": "fgMuted",    "light": "fgMutedLight" },
    "markdownEmph":           { "dark": "typeBuiltin","light": "typeBuiltinLight" },
    "markdownStrong":         { "dark": "kw",         "light": "kwLight" },
    "markdownHorizontalRule": { "dark": "lineNr",     "light": "lineNrLight" },
    "markdownListItem":       { "dark": "glowGreen",  "light": "glowGreenLight" },
    "markdownListEnumeration":{ "dark": "bool",       "light": "boolLight" },
    "markdownImage":          { "dark": "bool",       "light": "boolLight" },
    "markdownImageText":      { "dark": "constant",   "light": "constantLight" },
    "markdownCodeBlock":      { "dark": "fg",         "light": "fgLight" },

    "syntaxComment":     { "dark": "comment",     "light": "commentLight" },
    "syntaxKeyword":     { "dark": "kw",           "light": "kwLight" },
    "syntaxFunction":    { "dark": "func",         "light": "funcLight" },
    "syntaxVariable":    { "dark": "identifier",   "light": "identifierLight" },
    "syntaxString":      { "dark": "string",       "light": "stringLight" },
    "syntaxNumber":      { "dark": "constant",     "light": "constantLight" },
    "syntaxType":        { "dark": "type",         "light": "typeLight" },
    "syntaxOperator":    { "dark": "glowGreen",    "light": "glowGreenLight" },
    "syntaxPunctuation": { "dark": "bracket",      "light": "bracketLight" }
  }
}
