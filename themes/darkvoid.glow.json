{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c0c0c0",
    "margin": 2
  },
  "block_quote": {
    "color": "#585858",
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2,
    "color": "#c0c0c0"
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#e1e1e1",
    "bold": true
  },
  "h1": {
    "prefix": "▌ ",
    "color": "#f1f1f1",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#b2d8d8",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#66b2b2"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#a1a1a1"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#8a8a8a"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#585858",
    "bold": false
  },
  "text": {
    "color": "#c0c0c0"
  },
  "strikethrough": {
    "crossed_out": true,
    "color": "#585858"
  },
  "emph": {
    "italic": true,
    "color": "#d1d1d1"
  },
  "strong": {
    "bold": true,
    "color": "#f1f1f1"
  },
  "hr": {
    "color": "#404040",
    "format": "\n──────────\n"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#c0c0c0"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#c0c0c0"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#1bfd9c",
    "underline": true
  },
  "link_text": {
    "color": "#e1e1e1",
    "bold": true
  },
  "image": {
    "color": "#b2d8d8",
    "underline": true
  },
  "image_text": {
    "color": "#585858",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#1bfd9c",
    "background_color": "#303030"
  },
  "code_block": {
    "color": "#c0c0c0",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#c0c0c0"
      },
      "error": {
        "color": "#1c1c1c",
        "background_color": "#dea6a0"
      },
      "comment": {
        "color": "#585858",
        "italic": true
      },
      "comment_preproc": {
        "color": "#4b8902"
      },
      "keyword": {
        "color": "#f1f1f1",
        "bold": true
      },
      "keyword_reserved": {
        "color": "#f1f1f1"
      },
      "keyword_namespace": {
        "color": "#4b8902"
      },
      "keyword_type": {
        "color": "#a1a1a1"
      },
      "operator": {
        "color": "#1bfd9c"
      },
      "punctuation": {
        "color": "#e6e6e6"
      },
      "name": {
        "color": "#b1b1b1"
      },
      "name_builtin": {
        "color": "#c5c5c5"
      },
      "name_tag": {
        "color": "#e1e1e1"
      },
      "name_attribute": {
        "color": "#b1b1b1"
      },
      "name_class": {
        "color": "#e1e1e1",
        "underline": true,
        "bold": true
      },
      "name_constant": {
        "color": "#b2d8d8"
      },
      "name_decorator": {
        "color": "#4b8902"
      },
      "name_exception": {
        "color": "#dea6a0"
      },
      "name_function": {
        "color": "#e1e1e1"
      },
      "name_other": {
        "color": "#b1b1b1"
      },
      "literal": {
        "color": "#c0c0c0"
      },
      "literal_number": {
        "color": "#b2d8d8"
      },
      "literal_date": {
        "color": "#b2d8d8"
      },
      "literal_string": {
        "color": "#d1d1d1"
      },
      "literal_string_escape": {
        "color": "#bdfe58"
      },
      "generic_deleted": {
        "color": "#ffb3ba"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#baffc9"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#585858"
      },
      "background": {
        "background_color": "#303030"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#e1e1e1"
  },
  "definition_description": {
    "block_prefix": "\n🠶 ",
    "color": "#c0c0c0"
  },
  "html_block": {},
  "html_span": {}
}
