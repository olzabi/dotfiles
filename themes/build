#!/usr/bin/env python3
"""Regenerate themes/light/ and themes/auto/ from themes/dark/ (see themes/README.md).

  themes/build          rebuild everything
  themes/build --check  rebuild into a temp dir and fail if the tracked output is stale

dark/  hand-edited darkvoid sources        light/  the same files in dim-light (generated)
auto/  one generated file holding both modes, for apps that switch by themselves inside one file
Every colour goes through darkvoid-light.py; the per-app rules below only fix what is not a colour
(theme names, a base theme, a backgroundless flavor, a light/dark flag).
"""
import colorsys, filecmp, importlib.util, json, pathlib, re, shutil, subprocess, sys, tempfile

T = pathlib.Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location('dl', T / 'darkvoid-light.py')
dl = importlib.util.module_from_spec(spec); spec.loader.exec_module(dl)
conv = dl.convert_text


def light_plain(src, out):  # most files: every colour converted, nothing else
    out.write_text(conv(src.read_text()))


def sub(*pairs):  # light_plain plus literal replacements applied to the converted text
    def f(src, out):
        t = conv(src.read_text())
        for a, b in pairs:
            assert a in t, f'{src.name}: {a!r} not found'
            t = t.replace(a, b)
        out.write_text(t)
    return f


def yazi(src, out):  # flavor dir; light drops the paper backgrounds so the terminal's own paper shows through
    out.mkdir(exist_ok=True)
    fl = (src / 'flavor.toml').read_text()
    fl = re.sub(r'^overall *= *\{ bg = "#1c1c1c" \}', 'overall = {}', fl, flags=re.M).replace(', bg = "#1c1c1c"', '')
    (out / 'flavor.toml').write_text(conv(fl))
    (out / 'tmtheme.xml').write_text(conv((src / 'tmtheme.xml').read_text()))


def idea(src, out):  # .icls colours are bare hex
    t = src.read_text()
    t = re.sub(r'value="([0-9A-Fa-f]{5})"', r'value="0\1"', t)
    t = re.sub(r'value="([0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?)"', lambda m: f'value="{conv("#" + m[1])[1:].upper()}"', t)
    out.write_text(t.replace('DarkVoid v1', 'DarkVoid Light v1').replace('parent_scheme="Darcula"', 'parent_scheme="Default"'))


def fzf(src, out):  # fzf-tab: light keeps the terminal background (bg:-1)
    out.write_text(conv(src.read_text()).replace(f'bg:{dl.BG}', 'bg:-1'))


def json_edit(**kv):
    def f(src, out):
        d = json.loads(conv(src.read_text()))
        d.update(kv)
        out.write_text(json.dumps(d, indent=2, ensure_ascii=False) + '\n')
    return f


def nvim(src, out):  # darkvoid.nvim keeps its colours in the plugin; nvim's own palette fills the rest
    plugin = pathlib.Path.home() / '.local/share/nvim/lazy/darkvoid.nvim/lua/darkvoid/colors.lua'
    if not plugin.exists():
        return print('  nvim: darkvoid.nvim not installed, kept the tracked light/nvim.lua')
    pairs = re.findall(r'^\s*([a-z_]+) = "(#[0-9a-fA-F]{6})"', plugin.read_text(), re.M)
    lines = ['-- generated by themes/build from darkvoid.nvim defaults; do not edit', 'return {']
    lines += [f'  {k} = "{dl.to_light(v)}",' for k, v in pairs]
    lua = (r'for n, v in pairs(vim.api.nvim_get_color_map()) do local r = n:match "^NvimDark(.+)$" '
           r'if r and not r:find "Gray" then if r:find "Grey" then io.write("NvimLight", r, " ", ("#%06x"):format(v), "\n") end '
           r'io.write("NvimDark", r, " ", ("#%06x"):format(vim.api.nvim_get_color_by_name("NvimLight" .. r)), "\n") end end')
    try:
        nv = subprocess.run(['nvim', '--clean', '-l', '-'], input=lua, capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        nv = ''
    rows = sorted(l.split() for l in nv.splitlines() if len(l.split()) == 2)
    if rows:  # each nvim Light colour gets the light conversion of its Dark twin (colorscheme.lua remaps the rest)
        lines += ['  nvim = { -- nvim palette name -> light colour']
        lines += [f'    {k} = "{dl.to_light(v)}",' for k, v in rows]
        lines += ['  },']
    out.write_text('\n'.join(lines + ['}']) + '\n')


# ---- auto/: dark source + a generated light block in the same file -------------------------------------

def _block(text, start):
    """(begin, end) of the {...} block whose selector starts at `start`."""
    i = text.index('{', start); depth = 0
    for j in range(i, len(text)):
        depth += {'{': 1, '}': -1}.get(text[j], 0)
        if depth == 0:
            return start, j + 1
    raise ValueError('unbalanced braces')


RGBA = re.compile(r'rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(,\s*[\d.]+\s*)?\)')
def conv_css(t):
    t = RGBA.sub(lambda m: (lambda h: f'rgba({int(h[1:3], 16)}, {int(h[3:5], 16)}, {int(h[5:7], 16)}{m[4] or ", 1"})')(
        dl.to_light('#%02x%02x%02x' % tuple(int(m[i]) for i in (1, 2, 3)))), t)
    t = conv(t)
    acc = re.search(r'--dv-focus:\s*(#[0-9a-f]{6})', t)
    if acc:  # obsidian's accent is hsl numbers: recompute them from the converted accent
        r, g, b = (int(acc[1][i:i + 2], 16) / 255 for i in (1, 3, 5))
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        for k, v in (('h', f'{round(h * 360)}'), ('s', f'{round(s * 100)}%'), ('l', f'{round(l * 100)}%')):
            t = re.sub(rf'(--accent-{k}:\s*)[^;]+', rf'\g<1>{v}', t)
    return t


def css_auto(selector, wrap, rename=None):
    """Copy the dark source and append its `selector` block converted, wrapped by `wrap` (format string)."""
    def f(src, out):
        t = src.read_text()
        b, e = _block(t, re.search(rf'^\s*{re.escape(selector)}\s*\{{', t, re.M).start())
        light = conv_css(t[b:e])
        if rename:
            light = light.replace(selector, rename, 1)
        out.write_text(t.rstrip('\n') + '\n\n/* darkvoid dim-light: generated by themes/build from the block above */\n'
                       + wrap.format(light) + '\n')
    return f


def gtk(src, out):  # the light block has to sit before the trailing @import of noctalia's own css
    tmp = out.with_suffix('.tmp')
    t = src.read_text(); imp = '@import url("noctalia.css");'
    tmp.write_text(t.replace(imp, '').rstrip() + '\n')
    css_auto(':root', '@media (prefers-color-scheme: light) {{\n  {}\n}}')(tmp, out)
    tmp.unlink()
    out.write_text(out.read_text().rstrip('\n') + f'\n\n{imp}\n')


def noctalia(src, out):
    d = json.loads(src.read_text())
    d['light'] = json.loads(conv(json.dumps(d['dark'])))
    out.write_text(json.dumps(d, indent=2) + '\n')


def telegram(src, out):
    tg = importlib.util.spec_from_file_location('tg', T / 'telegram.py')
    m = importlib.util.module_from_spec(tg); tg.loader.exec_module(m)
    m.main(src, out.parent.parent)  # writes dark/ and light/ telegram.tdesktop-theme


def telegram_ios(src, out):
    """Telegram iOS/iPadOS: fills (bg/background/fill/startButton keys) become pale tints so text on them stays
    readable; dark text that sat on darkvoid's bright accent fills becomes ink; day base, dark status bar."""
    fill = re.compile(r'(bg|Bg|background|Background|fill|Fill|startButton)')
    ink = dl.to_light('#c0c0c0')

    def one(m):
        key, h, a = m[1], '#' + m[2].lower(), m[3] or ''
        _, C, H = dl.oklch(h)
        if fill.search(key) and C >= 0.015 and dl.contrast(h, dl.DARK_BG) >= 1.6:
            out_ = dl._darker(min(C, 0.06), H, 1.3)
        elif not fill.search(key) and h == dl.DARK_BG:  # text drawn on an accent fill: ink, links stay accent
            out_ = dl.to_light('#83b7ad') if 'link' in key.lower() else ink
        else:
            out_ = dl.to_light(h)
        if 'link' in key.lower() and not fill.search(key):  # links sit on bubbles darker than the page: deeper ink
            _, lc, lh = dl.oklch(out_)
            out_ = dl._darker(lc, lh, 5.5)
        return f'{key}: {out_.upper()}{a.upper()}'
    t = re.sub(r'^([A-Za-z0-9_]+): #([0-9A-Fa-f]{6})([0-9A-Fa-f]{2})?$', one, src.read_text(), flags=re.M)
    for k, v in (('name', 'Darkvoid Light'), ('shortname', 'darkvoid-light'), ('basedOn', 'day'), ('dark', 'false'),
                 ('intro_statusBar', 'black'), ('root_statusBar', 'black'), ('root_keyboard', 'light'),
                 ('actionSheet_bgType', 'light'), ('notification_expanded_bgType', 'light')):
        t = re.sub(rf'^{k}: .*$', f'{k}: {v}', t, flags=re.M)
    t = re.sub(r'^wallpaper: #[0-9A-Fa-f]{6}', f'wallpaper: {dl.to_light("#161616").upper()}', t, flags=re.M)
    out.write_text(t)


def niri(src, out):  # focus ring: vivid focus / faint unfocused; shadows stay shadows
    t = conv(src.read_text())
    t = re.sub(r'(focus-ring \{[^}]*?active-color )"#[0-9a-f]{6}"', rf'\1"{dl.FOCUS}"', t)
    t = re.sub(r'(focus-ring \{[^}]*?inactive-color )"#[0-9a-f]{6}"', rf'\1"{dl.FAINT}"', t)
    t = re.sub(r'(workspace-shadow \{[^}]*?color )"#[0-9a-f]{6}"', r'\1"#0000004d"', t)
    out.write_text(t)


def herdr(src, out):  # pane focus is the accent
    d = json.loads(conv(src.read_text()))
    d['colors']['accent'] = dl.FOCUS
    out.write_text(json.dumps(d, indent=2, ensure_ascii=False) + '\n')


def kitty(src, out):  # split borders like niri's focus ring
    t = conv(src.read_text())
    t = re.sub(r'^(active_border_color\s+)#[0-9a-f]{6}', rf'\g<1>{dl.FOCUS}', t, flags=re.M)
    t = re.sub(r'^(inactive_border_color\s+)#[0-9a-f]{6}', rf'\g<1>{dl.FAINT}', t, flags=re.M)
    out.write_text(t)


def darkreader(src, out):  # Dark Reader settings (import once): websites get the dark or light scheme by system mode
    d = json.loads(src.read_text()); t = d['theme']
    t['lightSchemeBackgroundColor'] = dl.to_light(t['darkSchemeBackgroundColor'])
    t['lightSchemeTextColor'] = dl.to_light(t['darkSchemeTextColor'])
    out.write_text(json.dumps(d, indent=2) + '\n')


# name in dark/ -> (scope, builder). scope: light | auto
APPS = {
    'kitty.conf': ('light', kitty),
    'niri.kdl': ('light', niri),
    'bat.tmTheme': ('light', light_plain),
    'delta.gitconfig': ('light', sub(('dark = true', 'light = true'), ('syntax-theme = darkvoid', 'syntax-theme = darkvoid-light'))),
    'yazi': ('light', yazi),
    'television.toml': ('light', light_plain),
    'atuin.toml': ('light', light_plain),
    'starship.toml': ('light', light_plain),
    'glow.json': ('light', light_plain),
    'eza': ('light', lambda s, o: (o.mkdir(exist_ok=True), light_plain(s / 'theme.yml', o / 'theme.yml'))),
    'lazygit.yml': ('light', light_plain),
    'hunk.toml': ('light', sub(('base = "github-dark-default"', 'base = "github-light-default"'))),
    'lazyjj.toml': ('light', light_plain),
    'ai-usagebar.toml': ('light', light_plain),
    'posting.yaml': ('light', light_plain),
    'rofi.rasi': ('light', light_plain),
    'fzf-tab.zsh': ('light', fzf),
    'claude.json': ('light', json_edit(name='Darkvoid light', base='light-ansi')),
    'pi.json': ('light', json_edit(name='darkvoid-light', appearance='light')),
    'omp.json': ('light', json_edit(name='darkvoid-light')),
    'herdr-app.json': ('light', herdr),
    'idea.icls': ('light', idea),
    'nvim': ('light', nvim),  # source: the darkvoid.nvim plugin (dark/nvim is a note)
    'telegram.night-palette': ('light', telegram),
    'telegram-ios.tgios-theme': ('light', telegram_ios),
    'noctalia.json': ('auto', noctalia),
    'gtk.css': ('auto', gtk),
    'firefox-chrome.css': ('auto', css_auto(':root', '@media (prefers-color-scheme: light) {{\n  {}\n}}')),
    'firefox-content.css': ('auto', css_auto(':root', '@-moz-document url-prefix("about:") {{\n  @media (prefers-color-scheme: light) {{\n    {}\n  }}\n}}')),
    'obsidian.css': ('auto', css_auto('.theme-dark', '{}', '.theme-light')),
    'darkreader.json': ('auto', darkreader),
}
OUT_NAME = {'nvim': 'nvim.lua', 'telegram.night-palette': 'telegram.tdesktop-theme'}


def build(root):
    for name, (scope, fn) in APPS.items():
        src = T / 'dark' / name
        if not src.exists():
            sys.exit(f'themes/build: missing source dark/{name}')
        out = root / scope / OUT_NAME.get(name, name)
        out.parent.mkdir(parents=True, exist_ok=True)
        fn(src, out)


if __name__ == '__main__':
    if sys.argv[1:] == ['--check']:
        with tempfile.TemporaryDirectory() as d:
            d = pathlib.Path(d)
            for s in ('light', 'auto', 'dark'):
                shutil.copytree(T / s, d / s, dirs_exist_ok=True)
            build(d)
            stale = [str(p.relative_to(d)) for s in ('light', 'auto') for p in (d / s).rglob('*')
                     if p.is_file() and not ((T / p.relative_to(d)).exists() and filecmp.cmp(p, T / p.relative_to(d), shallow=False))]
        sys.exit(f'themes/build: stale {stale}' if stale else 0)
    dl.test()
    build(T)
    print('themes/build: light/ and auto/ regenerated')
