{
  "$schema": "https://opencode.ai/config.json",
  "model": "nano-gpt/qwen-3.6-plus",
  "autoupdate": true,
  "instructions": ["persona/SOUL.md", "persona/STYLE.md"],
  "server": {
    "port": 4096
  },
  "plugin": [
    "plugins/graphify.js"
  ],
  "mcp": {},
  "tools": {},
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env.*": "deny",
      ".env.example": "deny"
    },
    "write": "allow",
    "grep": "allow",
    "list": "allow",
    "glob": "allow",
    "edit":"allow",
    "bash":"ask",
    "webfetch": "allow"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  }
}
