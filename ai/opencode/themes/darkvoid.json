{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":          "#1c1c1c",
    "bgPanel":     "#242424",
    "bgElement":   "#2a2a2a",
    "bgVisual":    "#303030",
    "fg":          "#c0c0c0",
    "fgDim":       "#b1b1b1",
    "fgMuted":     "#585858",
    "lineNr":      "#404040",
    "comment":     "#585858",
    "string":      "#d1d1d1",
    "func":        "#e1e1e1",
    "kw":          "#f1f1f1",
    "type":        "#a1a1a1",
    "typeBuiltin": "#c5c5c5",
    "identifier":  "#b1b1b1",
    "bracket":     "#e6e6e6",
    "constant":    "#b2d8d8",
    "bool":        "#66b2b2",
    "preprocessor":"#4b8902",
    "glowGreen":   "#1bfd9c",
    "cursor":      "#bdfe58",
    "added":       "#baffc9",
    "changed":     "#ffffba",
    "removed":     "#ffb3ba",
    "border":      "#2e2e2e",
    "borderActive":"#404040"
  },
  "theme": {
    "primary":    { "dark": "glowGreen",   "light": "glowGreen" },
    "secondary":  { "dark": "bool",        "light": "bool" },
    "accent":     { "dark": "cursor",      "light": "cursor" },
    "error":      { "dark": "removed",     "light": "removed" },
    "warning":    { "dark": "changed",     "light": "changed" },
    "success":    { "dark": "added",       "light": "added" },
    "info":       { "dark": "bool",        "light": "bool" },

    "text":            { "dark": "fg",        "light": "fg" },
    "textMuted":       { "dark": "fgMuted",   "light": "fgMuted" },
    "background":      { "dark": "bg",        "light": "bg" },
    "backgroundPanel": { "dark": "bgPanel",   "light": "bgPanel" },
    "backgroundElement":{ "dark": "bgElement","light": "bgElement" },
    "border":          { "dark": "border",    "light": "border" },
    "borderActive":    { "dark": "borderActive","light": "borderActive" },
    "borderSubtle":    { "dark": "border",    "light": "border" },

    "diffAdded":              { "dark": "added",     "light": "added" },
    "diffRemoved":            { "dark": "removed",   "light": "removed" },
    "diffContext":            { "dark": "fgMuted",   "light": "fgMuted" },
    "diffHunkHeader":         { "dark": "lineNr",    "light": "lineNr" },
    "diffHighlightAdded":     { "dark": "glowGreen", "light": "glowGreen" },
    "diffHighlightRemoved":   { "dark": "removed",   "light": "removed" },
    "diffAddedBg":            { "dark": "#1e2a1e",   "light": "#1e2a1e" },
    "diffRemovedBg":          { "dark": "#2a1e1e",   "light": "#2a1e1e" },
    "diffContextBg":          { "dark": "bgPanel",   "light": "bgPanel" },
    "diffLineNumber":         { "dark": "lineNr",    "light": "lineNr" },
    "diffAddedLineNumberBg":  { "dark": "#1c2a1c",   "light": "#1c2a1c" },
    "diffRemovedLineNumberBg":{ "dark": "#2a1c1c",   "light": "#2a1c1c" },

    "markdownText":           { "dark": "fg",         "light": "fg" },
    "markdownHeading":        { "dark": "glowGreen",  "light": "glowGreen" },
    "markdownLink":           { "dark": "bool",       "light": "bool" },
    "markdownLinkText":       { "dark": "constant",   "light": "constant" },
    "markdownCode":           { "dark": "string",     "light": "string" },
    "markdownBlockQuote":     { "dark": "fgMuted",    "light": "fgMuted" },
    "markdownEmph":           { "dark": "typeBuiltin","light": "typeBuiltin" },
    "markdownStrong":         { "dark": "kw",         "light": "kw" },
    "markdownHorizontalRule": { "dark": "lineNr",     "light": "lineNr" },
    "markdownListItem":       { "dark": "glowGreen",  "light": "glowGreen" },
    "markdownListEnumeration":{ "dark": "bool",       "light": "bool" },
    "markdownImage":          { "dark": "bool",       "light": "bool" },
    "markdownImageText":      { "dark": "constant",   "light": "constant" },
    "markdownCodeBlock":      { "dark": "fg",         "light": "fg" },

    "syntaxComment":     { "dark": "comment",     "light": "comment" },
    "syntaxKeyword":     { "dark": "kw",           "light": "kw" },
    "syntaxFunction":    { "dark": "func",         "light": "func" },
    "syntaxVariable":    { "dark": "identifier",   "light": "identifier" },
    "syntaxString":      { "dark": "string",       "light": "string" },
    "syntaxNumber":      { "dark": "constant",     "light": "constant" },
    "syntaxType":        { "dark": "type",         "light": "type" },
    "syntaxOperator":    { "dark": "glowGreen",    "light": "glowGreen" },
    "syntaxPunctuation": { "dark": "bracket",      "light": "bracket" }
  }
}
