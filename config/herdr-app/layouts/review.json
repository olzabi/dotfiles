{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "custom-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "review-changes",
              "type": "block",
              "content": {
                "mod": "my-changes"
              },
              "size": {
                "weight": 3
              },
              "background": "background",
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              }
            },
            {
              "id": "review-files",
              "type": "block",
              "content": {
                "mod": "files"
              },
              "size": {
                "weight": 2
              },
              "min": 260,
              "background": "background",
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        },
        {
          "id": "popup-host",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "popup"
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}