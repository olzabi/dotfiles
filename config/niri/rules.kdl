window-rule {
    match is-floating=true
    tiled-state false
    geometry-corner-radius 10
    clip-to-geometry true
    border {
        on
        width 1
        active-color "#343438"
        inactive-color "#28282C"
        urgent-color "#ffb86b"
    }
    shadow {
        on
        softness 10
        spread 6
        offset x=1 y=1
        color "rgba(14,14,14,0.6)"
    }
}
window-rule {
    tiled-state true
    clip-to-geometry true
    geometry-corner-radius 10
    draw-border-with-background false
}
window-rule {
    match is-floating=false
    tiled-state true
    geometry-corner-radius 10
}
window-rule {
    match app-id="^popup-"
    open-floating true
    default-column-width {
        fixed 1600
    }
    default-window-height {
        fixed 900
    }
}
window-rule {
    match app-id="^org\\.pulseaudio\\.pavucontrol$"
    match app-id="^pavucontrol$"
    open-floating true
    open-focused true
    default-column-width {
        fixed 600
    }
    default-window-height {
        fixed 600
    }
    // optional: open under the bar at the top right instead of centered
    default-floating-position x=16 y=48 relative-to="top-right"
}
window-rule {
    match app-id="steam" title="^Friends List$"
    open-floating true
    default-floating-position x=16 y=48 relative-to="top-right"
    default-column-width {
        fixed 350
    }
    default-window-height {
        fixed 700
    }
}
window-rule {
    match app-id="^chromium$" title="^Picture in picture$"
    match app-id="^firefox$" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 400; }
    default-floating-position x=16 y=48 relative-to="top-right"
}
// Firefox side windows: Library (bookmarks/history/downloads), About, Page Info.
window-rule {
    match app-id="^firefox$" title="^(Library|About Mozilla Firefox)$"
    match app-id="^firefox$" title="^Page Info — "
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
}
window-rule {
    match app-id="^org\\.telegram\\.desktop$" title="^Media viewer$"
    open-fullscreen false
}
window-rule {
    match app-id="org.remmina.Remmina"
    open-maximized true
}
window-rule {
    match app-id="nm-connection-editor"
    open-floating true
}
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    open-floating true
    open-focused false
    default-floating-position x=16 y=16 relative-to="bottom-right"
}
window-rule {
    match app-id="^herdr-app$"
    opacity 0.965 // herdr-app has no see-through window of its own; matches kitty's background_opacity
}
