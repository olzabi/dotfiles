window-rule {
    match app-id="^popup-"
    open-floating true
    default-column-width {
        fixed 1600
    }
    default-window-height {
        fixed 900
    }
}
window-rule {
    match app-id="^org\\.pulseaudio\\.pavucontrol$"
    match app-id="^pavucontrol$"
    open-floating true
    open-focused true
    default-column-width {
        fixed 600
    }
    default-window-height {
        fixed 600
    }
    // optional: open under the bar at the top right instead of centered
    default-floating-position x=16 y=48 relative-to="top-right"
}
window-rule {
    match app-id="steam" title="^Friends List$"
    open-floating true
    default-floating-position x=16 y=48 relative-to="top-right"
    default-column-width {
        fixed 350
    }
    default-window-height {
        fixed 700
    }
}
window-rule {
    match app-id="^chromium$" title="^Picture in picture$"
    match app-id="^firefox$" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 400; }
    default-floating-position x=16 y=48 relative-to="top-right"
}
// Firefox side windows: Library (bookmarks/history/downloads), About, Page Info.
window-rule {
    match app-id="^firefox$" title="^(Library|About Mozilla Firefox)$"
    match app-id="^firefox$" title="^Page Info — "
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
}
window-rule {
    match app-id=r#"^org\.telegram\.desktop"# title="^Media viewer$" // app-id carries a per-install suffix
    open-fullscreen false
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
}
window-rule {
    match app-id="org.remmina.Remmina"
    open-maximized true
}
// Small settings tools and prompts: float instead of taking a column.
window-rule {
    match app-id="nm-connection-editor"
    match app-id="^blueman-manager$"
    match app-id=r#"^com\.github\.wwmm\.easyeffects$"#
    match app-id="^(nwg-look|nvidia-settings|qopenvpn|zenity)$"
    match app-id="pinentry"
    match app-id="^xdg-desktop-portal-gtk$"
    match app-id="^discord$" title="^Discord Updater$"
    open-floating true
}
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    open-floating true
    open-focused false
    default-floating-position x=16 y=16 relative-to="bottom-right"
}
window-rule {
    match app-id="^herdr-app$"
    opacity 0.99 // herdr-app has no see-through window of its own; matches kitty's background_opacity
}
window-rule {
    match app-id="^kitty$"
    background-effect { blur true; } // acrylic: blur what shows through background_opacity
}
// Quick-access kitty is a layer surface: niri has no border/focus-ring for layers, so shadow + corners only (same as floating windows in theme.kdl).
layer-rule {
    match namespace="quick-access"
    geometry-corner-radius 10
    shadow {
        on
        softness 10
        spread 6
        offset x=1 y=1
        color "rgba(14,14,14,0.6)"
    }
}
