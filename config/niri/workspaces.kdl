// Big monitor (HDMI-A-2) holds the named workspaces in priority order, under niri's empty one at the top:
// secondary (podman), dev (everything without a rule), chat, games. Unnamed ones appear above and below as needed;
// Mod+2..5 reach the named ones by name, so dev stays Mod+3 however many there are (binds/ws.kdl).
// Small monitor (HDMI-A-1) is for videos only.
workspace "secondary" { open-on-output "HDMI-A-2"; }
workspace "dev" { open-on-output "HDMI-A-2"; }
workspace "chat" { open-on-output "HDMI-A-2"; }
workspace "games" { open-on-output "HDMI-A-2"; }

window-rule {
    match app-id=r#"^io\.podman_desktop\.PodmanDesktop$"#
    open-on-workspace "secondary"
}

window-rule {
    match app-id=r#"^org\.telegram\.desktop"#
    match app-id="^discord$"
    exclude title="^Media viewer$"
    open-on-workspace "chat"
}

// At login they open in the background; opened later (tray, launcher) they take focus as usual.
window-rule {
    match app-id=r#"^io\.podman_desktop\.PodmanDesktop$"# at-startup=true
    match app-id=r#"^org\.telegram\.desktop"# at-startup=true
    match app-id="^discord$" at-startup=true
    open-focused false
}

window-rule {
    match app-id="^steam$"
    match app-id=r#"^steam_app_\d+$"#
    match app-id="^gamescope$"
    exclude title=r#"^notificationtoasts_\d+_desktop$"#
    open-on-workspace "games"
}

// Small monitor: the video browser (bin/firefox-side, its own profile so niri can tell it apart) and video players.
window-rule {
    match app-id="^firefox-side$"
    match app-id="^(mpv|vlc)$"
    exclude title="^Picture-in-Picture$"
    open-on-output "HDMI-A-1"
}

// Rnote (pen notes) on the iPad when Extend is on; otherwise niri opens it where you are.
window-rule {
    match app-id=r#"^com\.github\.flxzt\.rnote$"#
    open-on-output "DP-1"
    open-maximized true
}

// Obsidian (notes, ob previews) on the big monitor.
window-rule {
    match app-id=r#"^(obsidian|md\.obsidian\.Obsidian)$"#
    open-on-output "HDMI-A-2"
}
