// The two monitors are the split: HDMI-A-2 (big) holds dev and the main browser side by side,
// HDMI-A-1 (small) holds the side stuff. Only games get a workspace of their own.
workspace "games" { open-on-output "HDMI-A-2"; }

window-rule {
    match app-id="^steam$"
    match app-id=r#"^steam_app_\d+$"#
    match app-id="^gamescope$"
    exclude title=r#"^notificationtoasts_\d+_desktop$"#
    open-on-workspace "games"
}

// Side monitor: the side browser (Mod+A, its own profile so niri can tell it apart), video players, chat.
window-rule {
    match app-id="^firefox-side$"
    match app-id="^(mpv|vlc)$"
    match app-id=r#"^org\.telegram\.desktop"#
    match app-id="^discord$"
    exclude title="^(Media viewer|Picture-in-Picture)$"
    open-on-output "HDMI-A-1"
}

// Rnote (pen notes) on the iPad when Extend is on; otherwise niri opens it where you are.
window-rule {
    match app-id=r#"^com\.github\.flxzt\.rnote$"#
    open-on-output "DP-1"
    open-maximized true
}

// Obsidian (notes, ob previews) on the big monitor.
window-rule {
    match app-id=r#"^(obsidian|md\.obsidian\.Obsidian)$"#
    open-on-output "HDMI-A-2"
}
