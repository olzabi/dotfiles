environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    MOZ_DISABLE_RDD_SANDBOX "1" // Firefox's sandboxed decoder can't open /dev/nvidia*, so nvidia-vaapi-driver silently falls back to CPU
    NVD_BACKEND "direct"        // nvidia-vaapi-driver's EGL backend is broken on driver 525+
    QT_QPA_PLATFORMTHEME "xdgdesktopportal" // Qt apps (Telegram) get light/dark from the portal; the default theme on niri reports "unknown", so auto-night never fires
 // XDG_DATA_DIRS "/usr/local/share:/usr/share"
    // MOZ_ENABLE_WAYLAND "1"
    // ELECTRON_OZONE_PLATFORM_HINT "auto"      // Electron apps (Discord, VS Code, etc.) run native Wayland, no blurry scaling
    // GDK_BACKEND "wayland,x11,*"
    // QT_QPA_PLATFORM "wayland;xcb"            // Qt apps prefer Wayland, fall back to X11
    // QT_QPA_PLATFORMTHEME "gtk3"
    // QT_QPA_PLATFORMTHEME "qt6ct"
    // QT_WAYLAND_DISABLE_WINDOWDECORATION "1"  // avoids Qt drawing its own title bars
}
input {
    keyboard {
        repeat-delay 300
        repeat-rate 45
        xkb {
            layout "us,ua"
            options "grp:win_space_toggle"
        }
        numlock
    }
    touchpad {
        tap
    }
    // Moonlight pen (Apple Pencil) and direct touch land on the iPad's Extend output; the mouse stays a separate pointer
    tablet {
        map-to-output "DP-1"
    }
    touch {
        map-to-output "DP-1"
    }
    mouse {
        accel-speed -0.5
        scroll-factor vertical=1.0 horizontal=-2.0
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth
}
output "HDMI-A-2" {
    mode "3840x2160@60.00"
    position x=0 y=0
    scale 1.1
    focus-at-startup
}
output "HDMI-A-1" {
    mode "1920x1080@60.00"
    position x=-1920 y=442
    scale 1
}
// iPad 11" via the tablet-display plugin (Extend, port method). Only exists while Extend is on.
// mode/scale/position repeat what the plugin applies, so a niri config reload doesn't move it.
output "DP-1" {
    mode "2778x1940@119.998"
    scale 2
    position x=5411 y=0
    hot-corners {
        off // stray touches in the corner shouldn't open the overview
    }
    layout {
        gaps 6
        default-column-width { proportion 1.0; } // 1389px logical: one window per screen
        preset-column-widths {
            proportion 0.5
            proportion 1.0
        }
        struts {
            left 0
            right 0
            top 0
            bottom 0
        }
    }
}
recent-windows {
    debounce-ms 750
    open-delay-ms 150
}
hotkey-overlay {
    skip-at-startup
}
screenshot-path "~/Media/Screenshots/%Y-%m-%d %H-%M-%S.png"
prefer-no-csd

