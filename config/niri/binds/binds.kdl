binds {
    Mod+X repeat=false { close-window; }
    Mod+A { spawn "sh" "-c" "mkdir -p ~/.config/mozilla/firefox/side && exec firefox --profile ~/.config/mozilla/firefox/side --name firefox-side"; }   // side browser (videos), lands on HDMI-A-1
    Mod+D repeat=false { toggle-overview; }
    Mod+T { toggle-column-tabbed-display; }   // the tmux-tabs replacement
    Mod+V { toggle-window-floating; }
    Mod+E { spawn "nautilus"; }
    Mod+F { maximize-column; }
    Mod+C { center-column; }

    Mod+Q { spawn "kitty" "-e" "tmux" "new-session" "-A" "-s" "main"; }
    Mod+Shift+Q { spawn "herdr-app"; }   // opens or raises the herdr-app window
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+A { screenshot; }

    // Window sizing and layout.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+W       { switch-preset-column-width; }
    Mod+Shift+W { switch-preset-column-width-back; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Minus   { set-column-width "-2%"; }
    Mod+Equal   { set-column-width "+2%"; }
}
