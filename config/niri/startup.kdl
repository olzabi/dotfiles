// niri is started directly (not niri-session): hand the Wayland env to systemd/dbus so portals (dark mode, file picker, screencast) can start.
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "DISPLAY" "XDG_CURRENT_DESKTOP" "NIRI_SOCKET" "QT_QPA_PLATFORMTHEME"
spawn-at-startup "noctalia" // bar, notifications, launcher (config/noctalia); replaces waybar + mako
// still frame of workshop 3411797914 (Mac Baconai), extracted from its scene.pkg; live wpe cost ~1.5 GB VRAM
spawn-sh-at-startup "swaybg -c '#1c1c1c' -o HDMI-A-2 -i ~/Media/Wallpapers/mac-baconai.jpg -m fill"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
// Puts named workspaces back on their monitor after a monitor drops and reconnects (bin/niri-home-workspaces).
spawn-sh-at-startup "~/Dotfiles/bin/niri-home-workspaces"

// Apps. Dev is focused first so the apps without a rule (firefox, herdr-app) open there; the others
// go to their own workspace without taking focus (workspaces.kdl).
spawn-sh-at-startup "niri msg action focus-workspace dev"
spawn-at-startup "firefox"
spawn-at-startup "herdr-app"
spawn-sh-at-startup "~/Dotfiles/bin/firefox-side"
spawn-at-startup "Telegram"
spawn-at-startup "discord"
spawn-at-startup "podman-desktop"

// niri exports XCURSOR_THEME/XCURSOR_SIZE from its cursor block; mirror them for GTK apps
// and for X11 apps (xwayland-satellite), which fall back to the "default" icon theme.
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface cursor-theme \"$XCURSOR_THEME\"; gsettings set org.gnome.desktop.interface cursor-size \"$XCURSOR_SIZE\"; d=~/.local/share/icons/default; mkdir -p $d && printf '[Icon Theme]\\nInherits=%s\\n' \"$XCURSOR_THEME\" > $d/index.theme"
