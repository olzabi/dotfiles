[include]
  path = darkvoid.gitconfig # themes/current/delta.gitconfig: the dark or light darkvoid feature

[core]
  pager = delta

[delta]
  features = darkvoid # the theme in darkvoid.gitconfig only applies when selected here
  navigate = true
  line-numbers = true
  decorations = true
  white-space-error-style = 22 reverse

[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta

[interactive]
  diffFilter = delta --color-only --features=interactive
